---
import series from "../../public/data/bot_share_timeseries.json";

// Use the 13-week moving average (smoother, more legible than weekly noise).
// Drop the first 13 weeks where the MA is still warming up; the early weeks
// also have very low volume and aren't representative.
type Pt = { date: string; bot_share?: number; bot_share_ma13w?: number };
const pts: Pt[] = (series as Pt[]).slice(12).filter(p => p.bot_share_ma13w != null);

const W = 720;
const H = 200;
const ML = 36, MR = 56, MT = 8, MB = 22;

const x = (i: number) => ML + (i / (pts.length - 1)) * (W - ML - MR);
const y = (v: number) => MT + (1 - v) * (H - MT - MB);

const line = pts.map((p, i) => `${i === 0 ? "M" : "L"} ${x(i).toFixed(1)} ${y(p.bot_share_ma13w!).toFixed(1)}`).join(" ");
const area = `${line} L ${x(pts.length - 1).toFixed(1)} ${(H - MB).toFixed(1)} L ${x(0).toFixed(1)} ${(H - MB).toFixed(1)} Z`;

// Year ticks
const yearTicks: { x: number; label: string }[] = [];
let lastYear = "";
pts.forEach((p, i) => {
  const yr = p.date.slice(0, 4);
  if (yr !== lastYear) {
    yearTicks.push({ x: x(i), label: yr });
    lastYear = yr;
  }
});

const last = pts[pts.length - 1];
const lastVal = last.bot_share_ma13w!;
---
<figure class="botshare-chart">
  <figcaption class="bsc-caption">
    <span class="bsc-title">Algorithmic share of weekly Polymarket trades, 13-week moving average</span>
    <span class="bsc-as-of">From a near-zero base in late 2022 to {(lastVal * 100).toFixed(0)}% today</span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="bsc-svg" aria-label="Algorithmic share over time">
    {/* gridlines */}
    {[0, 0.25, 0.5, 0.75, 1].map(v => (
      <g>
        <line x1={ML} x2={W - MR} y1={y(v)} y2={y(v)} class="bsc-grid" />
        <text x={ML - 6} y={y(v) + 3} class="bsc-axis" text-anchor="end">{(v * 100).toFixed(0)}%</text>
      </g>
    ))}
    {/* year ticks */}
    {yearTicks.map(t => (
      <g>
        <line x1={t.x} x2={t.x} y1={H - MB} y2={H - MB + 3} class="bsc-grid" />
        <text x={t.x} y={H - 6} class="bsc-axis" text-anchor="middle">{t.label}</text>
      </g>
    ))}
    {/* area + line */}
    <path d={area} class="bsc-area" />
    <path d={line} class="bsc-line" />
    {/* endpoint dot + label */}
    <circle cx={x(pts.length - 1)} cy={y(lastVal)} r="4" class="bsc-dot" />
    <text x={x(pts.length - 1) + 8} y={y(lastVal) + 4} class="bsc-endlabel">{(lastVal * 100).toFixed(0)}%</text>
  </svg>
</figure>
