---
import MiniSparkline from "./MiniSparkline.astro";

export interface Props {
  name: string;
  value: string;
  description: string;
  howToRead?: string;
  href: string;
  z52w?: number | null;
  sparklineUrl?: string;
  sparklineField?: string;
  meta?: string;
}
const {
  name,
  value,
  description,
  howToRead,
  href,
  z52w = null,
  sparklineUrl,
  sparklineField = "value",
  meta,
} = Astro.props;

const zSign =
  z52w === null || z52w === undefined || Number.isNaN(z52w)
    ? "neutral"
    : z52w > 0.5
    ? "pos"
    : z52w < -0.5
    ? "neg"
    : "neutral";

const zLabel =
  z52w === null || z52w === undefined || Number.isNaN(z52w)
    ? null
    : `${z52w >= 0 ? "+" : ""}${z52w.toFixed(2)}`;
---
<a class="index-card-rich" href={href}>
  <div class="top">
    <div class="name">{name}</div>
    {zLabel && <div class={`z-badge ${zSign}`}>z52w {zLabel}</div>}
  </div>
  <div class="value">{value}</div>
  {sparklineUrl && (
    <MiniSparkline dataUrl={sparklineUrl} yField={sparklineField} />
  )}
  <p class="desc">{description}</p>
  {howToRead && <p class="how-to-read"><span class="htr-label">How to read:</span> {howToRead}</p>}
  {meta && <div class="meta">{meta}</div>}
</a>
