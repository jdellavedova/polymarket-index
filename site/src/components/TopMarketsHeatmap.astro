---
/**
 * Finviz-style treemap of the top weekly Polymarket markets.
 *
 * Each rectangle = one market.
 *   Area = weekly USD volume (squarified treemap layout).
 *   Color = % algorithmic share for that market (high bot share = warmer
 *           color; bot-light retail-engaged markets = cooler color).
 *   Label = market question (truncated) + category tag.
 *   Hover = full question (browser tooltip via <title>).
 *
 * Data: top_markets_latest.json (questions + volumes + categories) joined to
 * market_microstructure_latest.json (per-market bot share). Markets without
 * microstructure context fall back to a neutral color.
 *
 * No JS chart library: layout computed at build time and emitted as inline SVG.
 */
import top from "../../public/data/top_markets_latest.json";

let micro: { markets: any[] } | null = null;
try {
  micro = await import("../../public/data/market_microstructure_latest.json");
} catch (_) {
  micro = { markets: [] };
}
const microById: Record<string, any> = Object.fromEntries(
  (micro?.markets ?? []).map((m: any) => [String(m.market_id), m])
);

let snap: { markets: any[] } | null = null;
try {
  snap = await import("../../public/data/market_snapshot_latest.json");
} catch (_) {
  snap = { markets: [] };
}
const snapById: Record<string, any> = Object.fromEntries(
  (snap?.markets ?? []).map((m: any) => [String(m.market_id), m])
);

type Market = {
  rank: number;
  market_id: string;
  question: string | null;
  category: string | null;
  usd_volume: number;
  n_trades: number;
  bot_share: number | null;
  yes_price: number | null;
  flagged: number | null;
};

const markets: Market[] = (top.markets as any[]).map(m => ({
  rank: m.rank,
  market_id: String(m.market_id),
  question: m.question ?? null,
  category: m.category ?? null,
  usd_volume: m.usd_volume,
  n_trades: m.n_trades,
  bot_share: microById[String(m.market_id)]?.bot_share_participation ?? null,
  yes_price: snapById[String(m.market_id)]?.yes_price ?? null,
  flagged: microById[String(m.market_id)]?.flagged_wallets_active ?? null,
}));

const W = 880;
const H = 520;

/** Squarified treemap (Bruls/Huijsmans/van Wijk 2000) with simplified slicing.
 *  Returns rectangles in the same order as the input items array. */
function squarify(items: { value: number }[], x: number, y: number, w: number, h: number) {
  const total = items.reduce((s, it) => s + it.value, 0);
  if (total <= 0) return items.map(() => ({ x, y, w: 0, h: 0 }));

  const result: { x: number; y: number; w: number; h: number }[] = new Array(items.length);

  function worst(row: number[], length: number) {
    const sum = row.reduce((s, v) => s + v, 0);
    const max = Math.max(...row);
    const min = Math.min(...row);
    return Math.max((length * length * max) / (sum * sum), (sum * sum) / (length * length * min));
  }

  function layoutRow(row: number[], rowIdx: number[], cx: number, cy: number, cw: number, ch: number, horizontal: boolean) {
    const sum = row.reduce((s, v) => s + v, 0);
    const total = horizontal ? ch : cw;
    const thick = sum / total;
    let off = 0;
    for (let k = 0; k < row.length; k++) {
      const seg = row[k] / thick;
      if (horizontal) {
        result[rowIdx[k]] = { x: cx, y: cy + off, w: thick, h: seg };
      } else {
        result[rowIdx[k]] = { x: cx + off, y: cy, w: seg, h: thick };
      }
      off += seg;
    }
    if (horizontal) return { x: cx + thick, y: cy, w: cw - thick, h: ch };
    return { x: cx, y: cy + thick, w: cw, h: ch - thick };
  }

  function recurse(itemsLeft: number[], idxLeft: number[], cx: number, cy: number, cw: number, ch: number) {
    if (itemsLeft.length === 0) return;
    const horizontal = ch < cw;
    const length = horizontal ? ch : cw;
    const sum = itemsLeft.reduce((s, v) => s + v, 0);
    const scale = (cw * ch) / sum;
    const scaled = itemsLeft.map(v => v * scale);

    let row: number[] = [];
    let rowIdx: number[] = [];
    let i = 0;
    while (i < scaled.length) {
      const rowTry = [...row, scaled[i]];
      if (row.length === 0 || worst(rowTry, length) <= worst(row, length)) {
        row.push(scaled[i]);
        rowIdx.push(idxLeft[i]);
        i++;
      } else {
        const next = layoutRow(row, rowIdx, cx, cy, cw, ch, horizontal);
        cx = next.x; cy = next.y; cw = next.w; ch = next.h;
        const nextSum = scaled.slice(i).reduce((s, v) => s + v, 0);
        const nextScale = (cw * ch) / Math.max(nextSum, 1e-9);
        recurse(itemsLeft.slice(i).map(v => v * nextScale / scale), idxLeft.slice(i), cx, cy, cw, ch);
        return;
      }
    }
    layoutRow(row, rowIdx, cx, cy, cw, ch, horizontal);
  }

  recurse(items.map(it => it.value), items.map((_, i) => i), x, y, w, h);
  return result;
}

const items = markets.map(m => ({ value: m.usd_volume }));
const rects = squarify(items, 0, 0, W, H);

/** Diverging palette pivoted at the Polymarket-wide baseline (~87% bot share).
 *  Cells BELOW baseline (retail-engaged, "interesting") render in cool teal.
 *  Cells AT baseline render in neutral slate-blue.
 *  Cells ABOVE baseline (very bot-dominated) render in warm amber/brown.
 *  All three endpoints have ~similar luminance (~22-30%) so white text
 *  carries 4.5:1+ contrast across the whole palette. */
const BASELINE = 0.87;
function lerp(a: number, b: number, t: number) { return Math.round(a + (b - a) * t); }
function rgb(r: number, g: number, b: number) { return `rgb(${r}, ${g}, ${b})`; }
function colorFromBotShare(bs: number | null) {
  if (bs == null) return rgb(46, 56, 72); // neutral fallback for missing data
  const t = Math.max(0, Math.min(1, bs));
  // Three keystops: cool teal #1f6470 -> neutral slate #2c3e54 -> warm amber #7a4a20
  if (t <= BASELINE) {
    // 0 -> 0.87 mapped to teal -> slate (a in [0,1])
    const a = t / BASELINE;
    return rgb(lerp(0x1f, 0x2c, a), lerp(0x64, 0x3e, a), lerp(0x70, 0x54, a));
  } else {
    // 0.87 -> 1.0 mapped to slate -> amber (a in [0,1])
    const a = (t - BASELINE) / (1 - BASELINE);
    return rgb(lerp(0x2c, 0x7a, a), lerp(0x3e, 0x4a, a), lerp(0x54, 0x20, a));
  }
}

function fmtVol(v: number) {
  if (v >= 1e6) return "$" + (v / 1e6).toFixed(1) + "M";
  if (v >= 1e3) return "$" + (v / 1e3).toFixed(0) + "K";
  return "$" + v.toFixed(0);
}

function truncate(s: string | null, max: number): string {
  if (!s) return "";
  if (s.length <= max) return s;
  return s.slice(0, max - 1).trimEnd() + "…";
}

/** Wrap a string into up to maxLines lines of approx charsLine each, breaking
 *  on word boundaries. Last line gets an ellipsis if text is truncated. */
function wrap(s: string | null, charsLine: number, maxLines: number): string[] {
  if (!s) return [];
  const words = s.split(/\s+/);
  const lines: string[] = [];
  let cur = "";
  for (const w of words) {
    const candidate = cur ? cur + " " + w : w;
    if (candidate.length <= charsLine) {
      cur = candidate;
    } else {
      if (cur) lines.push(cur);
      cur = w;
      if (lines.length >= maxLines) break;
    }
  }
  if (cur && lines.length < maxLines) lines.push(cur);
  // ellipsis if we ran out of room
  if (lines.length === maxLines) {
    const used = lines.join(" ").split(/\s+/).length;
    if (used < words.length) {
      lines[lines.length - 1] = lines[lines.length - 1].replace(/[\s…]+$/, "") + "…";
    }
  }
  return lines;
}
---
<figure class="topmkt-tm">
  <figcaption class="tm-caption">
    <span class="tm-title">Top {markets.length} Polymarket markets, week of {top.as_of_week}</span>
    <span class="tm-sub">
      Rectangle area = weekly USD volume. Color = algorithmic share for that market (lighter = more bot-mediated, darker = more retail-engaged). Hover for full market name.
    </span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="tm-svg" preserveAspectRatio="none" aria-label="Top markets heatmap">
    {rects.map((r, i) => {
      const m = markets[i];
      const col = colorFromBotShare(m.bot_share);
      const tooMini = r.w < 56 || r.h < 36;
      // Tier the typography by cell area (Finviz-style: bigger cell = bigger text)
      const area = r.w * r.h;
      const isHero = area >= 60000;       // ~ top 1-2 cells
      const isLarge = area >= 22000;
      const qFontPx = isHero ? 16 : (isLarge ? 13 : 11);
      const oddsFontPx = isHero ? 22 : (isLarge ? 17 : 14);
      // Inner width with 8px padding each side
      const innerW = r.w - 16;
      const charsLine = Math.max(4, Math.floor(innerW / (qFontPx * 0.55)));
      const maxQLines = isHero ? 3 : (isLarge ? 2 : 1);
      const qLines = m.question ? wrap(m.question, charsLine, maxQLines) : [];
      const showQuestion = !tooMini && qLines.length > 0;
      const qBlockH = qLines.length * (qFontPx + 3);
      const showOdds = !tooMini && r.h >= 56 && m.yes_price != null;
      const showVol = !tooMini && r.h >= 78;
      const showBot = !tooMini && r.h >= 100 && m.bot_share != null;
      return (
        <g class="tm-cell">
          <title>{`${m.question ?? "Market #" + m.market_id}\nVolume: ${fmtVol(m.usd_volume)}  ·  Trades: ${m.n_trades.toLocaleString()}\nImplied: ${m.yes_price != null ? (m.yes_price*100).toFixed(0)+"% YES" : "n/a"}\nAlgorithmic share: ${m.bot_share != null ? (m.bot_share*100).toFixed(0)+"%" : "n/a"}\nFlagged wallets: ${m.flagged ?? "n/a"}\nCategory: ${m.category ?? "n/a"}`}</title>
          <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={col} class="tm-rect" />
          {tooMini ? null : (
            <g>
              {showQuestion && qLines.map((line, li) => (
                <text
                  x={r.x + 8}
                  y={r.y + 8 + (li + 1) * (qFontPx + 2)}
                  class="tm-q"
                  style={`font-size:${qFontPx}px;`}
                >
                  {line}
                </text>
              ))}
              {showOdds && (
                <text
                  x={r.x + 8}
                  y={r.y + 14 + qBlockH + oddsFontPx}
                  class="tm-v"
                  style={`font-size:${oddsFontPx}px;`}
                >
                  {(m.yes_price! * 100).toFixed(0)}% YES
                </text>
              )}
              {showVol && (
                <text x={r.x + 8} y={r.y + 18 + qBlockH + oddsFontPx + 18} class="tm-vol">
                  {fmtVol(m.usd_volume)} vol
                </text>
              )}
              {showBot && (
                <text x={r.x + 8} y={r.y + 22 + qBlockH + oddsFontPx + 36} class="tm-bot">
                  {(m.bot_share! * 100).toFixed(0)}% algo
                </text>
              )}
            </g>
          )}
        </g>
      );
    })}
  </svg>
  <div class="tm-legend">
    <span class="tm-leg-label">Color = algorithmic share</span>
    <div class="tm-leg-grad-wrap">
      <span class="tm-leg-grad"></span>
      <div class="tm-leg-ticks">
        <span>0%</span>
        <span class="tm-leg-baseline">87% baseline</span>
        <span>100%</span>
      </div>
    </div>
    <span class="tm-leg-label tm-leg-right">Cool = retail-engaged · Warm = bot-dominant</span>
  </div>
</figure>
