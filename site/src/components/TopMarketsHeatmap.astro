---
/**
 * Finviz-style treemap of the top weekly Polymarket markets.
 *
 * Each rectangle = one market.
 *   Area = weekly USD volume (squarified treemap layout).
 *   Color = % algorithmic share for that market (high bot share = warmer
 *           color; bot-light retail-engaged markets = cooler color).
 *   Label = market question (truncated) + category tag.
 *   Hover = full question (browser tooltip via <title>).
 *
 * Data: top_markets_latest.json (questions + volumes + categories) joined to
 * market_microstructure_latest.json (per-market bot share). Markets without
 * microstructure context fall back to a neutral color.
 *
 * No JS chart library: layout computed at build time and emitted as inline SVG.
 */
import top from "../../public/data/top_markets_latest.json";

let micro: { markets: any[] } | null = null;
try {
  micro = await import("../../public/data/market_microstructure_latest.json");
} catch (_) {
  micro = { markets: [] };
}
const microById: Record<string, any> = Object.fromEntries(
  (micro?.markets ?? []).map((m: any) => [String(m.market_id), m])
);

let snap: { markets: any[] } | null = null;
try {
  snap = await import("../../public/data/market_snapshot_latest.json");
} catch (_) {
  snap = { markets: [] };
}
const snapById: Record<string, any> = Object.fromEntries(
  (snap?.markets ?? []).map((m: any) => [String(m.market_id), m])
);

type Market = {
  rank: number;
  market_id: string;
  question: string | null;
  category: string | null;
  usd_volume: number;
  n_trades: number;
  bot_share: number | null;
  yes_price: number | null;
  flagged: number | null;
};

const markets: Market[] = (top.markets as any[]).map(m => ({
  rank: m.rank,
  market_id: String(m.market_id),
  question: m.question ?? null,
  category: m.category ?? null,
  usd_volume: m.usd_volume,
  n_trades: m.n_trades,
  bot_share: microById[String(m.market_id)]?.bot_share_participation ?? null,
  yes_price: snapById[String(m.market_id)]?.yes_price ?? null,
  flagged: microById[String(m.market_id)]?.flagged_wallets_active ?? null,
}));

const W = 880;
const H = 520;

/** Squarified treemap (Bruls/Huijsmans/van Wijk 2000), iterative.
 *  Returns rectangles in the same order as the input items array.
 *  Each laid row consumes exactly its strip of the remaining rectangle, and
 *  the final item takes the exact remainder, so no division can hit 0/0. */
function squarify(items: { value: number }[], x: number, y: number, w: number, h: number) {
  const n = items.length;
  const total = items.reduce((s, it) => s + it.value, 0);
  if (total <= 0 || w <= 0 || h <= 0) return items.map(() => ({ x, y, w: 0, h: 0 }));

  const result: { x: number; y: number; w: number; h: number }[] = new Array(n);
  // Normalize values to pixel areas
  let areas = items.map(it => (it.value * w * h) / total);
  let idx = items.map((_, i) => i);
  let rx = x, ry = y, rw = w, rh = h;

  while (idx.length > 0) {
    // Last item takes the exact remainder
    if (idx.length === 1) {
      result[idx[0]] = { x: rx, y: ry, w: Math.max(rw, 0), h: Math.max(rh, 0) };
      break;
    }
    // Lay the next row along the shorter side of the remaining rectangle
    const len = Math.max(Math.min(rw, rh), 1e-9);
    const worst = (row: number[]) => {
      const s = row.reduce((a, b) => a + b, 0);
      const mx = Math.max(...row);
      const mn = Math.min(...row);
      if (mn <= 0 || s <= 0) return Infinity;
      return Math.max((len * len * mx) / (s * s), (s * s) / (len * len * mn));
    };
    // Grow the row while the worst aspect ratio keeps improving
    let row = [areas[0]];
    let k = 1;
    while (k < idx.length) {
      const cand = [...row, areas[k]];
      if (worst(cand) <= worst(row)) { row.push(areas[k]); k++; } else break;
    }
    // Emit the row as a strip of thickness sum/len along the shorter side
    const s = row.reduce((a, b) => a + b, 0);
    const thick = s / len;
    const vertical = rw >= rh; // strip stands at the left edge, cells stack down
    let off = 0;
    for (let j = 0; j < row.length; j++) {
      const seg = row[j] / thick;
      if (vertical) {
        result[idx[j]] = { x: rx, y: ry + off, w: thick, h: seg };
      } else {
        result[idx[j]] = { x: rx + off, y: ry, w: seg, h: thick };
      }
      off += seg;
    }
    if (vertical) { rx += thick; rw = Math.max(rw - thick, 0); }
    else          { ry += thick; rh = Math.max(rh - thick, 0); }
    idx = idx.slice(row.length);
    areas = areas.slice(row.length);
  }
  return result;
}

const items = markets.map(m => ({ value: m.usd_volume }));
const rects = squarify(items, 0, 0, W, H);

/** Category → colour map. Keys are exact strings from the pipeline's categorize.py.
 *  Desaturated tones tuned to the navy theme: distinct at a glance without
 *  fighting the page palette, and all readable under white labels. */
const CAT_MAP: Record<string, { color: string; label: string }> = {
  "Geopolitics":   { color: "#34548c", label: "Geopolitics" },
  "Politics":      { color: "#5e4f96", label: "Politics" },
  "Sports":        { color: "#2f7d62", label: "Sports" },
  "Macro":         { color: "#1f6e7e", label: "Macro / Finance" },
  "Finance":       { color: "#1f6e7e", label: "Macro / Finance" },
  "Economics":     { color: "#1f6e7e", label: "Macro / Finance" },
  "Crypto":        { color: "#a05c2e", label: "Crypto" },
  "Science":       { color: "#5d7fb8", label: "Science / Tech" },
  "Technology":    { color: "#5d7fb8", label: "Science / Tech" },
  "Entertainment": { color: "#96527c", label: "Entertainment" },
  "Health":        { color: "#3a7d6a", label: "Health" },
  "Other":         { color: "#46556b", label: "Other" },
};
const CAT_DEFAULT_COLOR = "#3c4a5e";
const CAT_DEFAULT_LABEL = "Other";

function resolveCategory(cat: string | null): { color: string; label: string } {
  if (!cat) return { color: CAT_DEFAULT_COLOR, label: CAT_DEFAULT_LABEL };
  if (CAT_MAP[cat]) return CAT_MAP[cat];
  // fuzzy fallback for unexpected strings
  const lc = cat.toLowerCase();
  for (const [k, v] of Object.entries(CAT_MAP)) {
    if (lc.includes(k.toLowerCase())) return v;
  }
  return { color: CAT_DEFAULT_COLOR, label: cat };
}

// Build legend: only categories present this week, in order of first appearance
const seenLabels = new Set<string>();
const legendEntries: { label: string; color: string }[] = [];
for (const m of markets) {
  const { color, label } = resolveCategory(m.category);
  if (!seenLabels.has(label)) { seenLabels.add(label); legendEntries.push({ label, color }); }
}

function fmtVol(v: number) {
  if (v >= 1e6) return "$" + (v / 1e6).toFixed(1) + "M";
  if (v >= 1e3) return "$" + (v / 1e3).toFixed(0) + "K";
  return "$" + v.toFixed(0);
}

function truncate(s: string | null, max: number): string {
  if (!s) return "";
  if (s.length <= max) return s;
  return s.slice(0, max - 1).trimEnd() + "…";
}

/** Wrap a string into up to maxLines lines of approx charsLine each, breaking
 *  on word boundaries. Last line gets an ellipsis if text is truncated. */
function wrap(s: string | null, charsLine: number, maxLines: number): string[] {
  if (!s) return [];
  const words = s.split(/\s+/);
  const lines: string[] = [];
  let cur = "";
  for (const w of words) {
    const candidate = cur ? cur + " " + w : w;
    if (candidate.length <= charsLine) {
      cur = candidate;
    } else {
      if (cur) lines.push(cur);
      cur = w;
      if (lines.length >= maxLines) break;
    }
  }
  if (cur && lines.length < maxLines) lines.push(cur);
  // ellipsis if we ran out of room
  if (lines.length === maxLines) {
    const used = lines.join(" ").split(/\s+/).length;
    if (used < words.length) {
      lines[lines.length - 1] = lines[lines.length - 1].replace(/[\s…]+$/, "") + "…";
    }
  }
  return lines;
}
---
<figure class="topmkt-tm">
  <figcaption class="tm-caption">
    <span class="tm-title">Top {markets.length} Polymarket markets, week of {top.as_of_week}</span>
    <span class="tm-sub">
      Rectangle area = weekly USD volume. Color = market category. Hover for full market name.
    </span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="tm-svg" preserveAspectRatio="none" role="img" aria-label="Top markets heatmap">
    <title>Top Polymarket markets by weekly volume</title>
    <desc>Treemap of the top 30 markets this week. Cell area is proportional to USD volume; cell color encodes market category.</desc>
    {rects.map((r, i) => {
      const m = markets[i];
      const { color: col } = resolveCategory(m.category);
      // Only truly unreadable slivers get no text; small cells drop to a
      // tiny tier (9px question, 10px odds) instead of going blank.
      const tooMini = r.w < 32 || r.h < 22;
      const area = r.w * r.h;
      const isHero  = area >= 60000;
      const isLarge = area >= 18000;
      const isTiny  = !isHero && !isLarge && (r.w < 80 || r.h < 64);
      // Font sizes
      const qFontPx     = isHero ? 13 : (isLarge ? 12 : (isTiny ? 9 : 11));
      const priceFontPx = isHero ? 20 : (isLarge ? 15 : (isTiny ? 10 : 13));
      const volFontPx   = isTiny ? 9 : 11;
      const pad         = isTiny ? 4 : 8;
      const volGap      = isTiny ? 11 : 16;
      // Wrap the question over as many lines as the cell can hold,
      // reserving room for the price + volume rows when present.
      const innerW  = r.w - pad * 2;
      const charsLine = Math.max(5, Math.floor(innerW / (qFontPx * 0.6)));
      const lineH = qFontPx + (isTiny ? 2 : 3);
      const priceReserve = m.yes_price != null ? priceFontPx + 5 + volGap + 3 : 3;
      const linesFit = Math.floor((r.h - pad - priceReserve - qFontPx) / lineH) + 1;
      const maxLines = Math.max(1, Math.min(isHero ? 5 : (isLarge ? 4 : 3), linesFit));
      const qLines = wrap(m.question, charsLine, maxLines);
      // Absolute y baselines
      const qY      = pad + qFontPx;
      const qBottom = qY + (qLines.length - 1) * lineH;
      const priceY  = qBottom + 5 + priceFontPx;
      const volY    = priceY + volGap;
      // Show each row only when it fits (3 px bottom margin)
      const showQ     = !tooMini && qLines.length > 0;
      const showPrice = !tooMini && m.yes_price != null && r.h >= priceY + 3;
      const showVol   = showPrice && r.h >= volY + 3;
      return (
        <svg x={r.x} y={r.y} width={r.w} height={r.h} overflow="hidden" class="tm-cell">
          <title>{`${m.question ?? "Market #" + m.market_id}\nVolume: ${fmtVol(m.usd_volume)}  ·  Trades: ${m.n_trades.toLocaleString()}\nImplied: ${m.yes_price != null ? (m.yes_price*100).toFixed(0)+"% YES" : "n/a"}\nAlgorithmic share: ${m.bot_share != null ? (m.bot_share*100).toFixed(0)+"%" : "n/a"}\nCategory: ${m.category ?? "n/a"}`}</title>
          <rect x={0} y={0} width={r.w} height={r.h} fill={col} class="tm-rect" />
          {showQ && qLines.map((line, li) => (
            <text x={pad} y={qY + li * lineH} font-size={qFontPx} class="tm-q">{line}</text>
          ))}
          {showPrice && (
            <text x={pad} y={priceY} font-size={priceFontPx} class="tm-v">
              {(m.yes_price! * 100).toFixed(0)}% YES
            </text>
          )}
          {showVol && (
            <text x={pad} y={volY} font-size={volFontPx} class="tm-vol">{fmtVol(m.usd_volume)} vol</text>
          )}
        </svg>
      );
    })}
  </svg>
  <div class="tm-legend">
    <span class="tm-leg-label">Color = category</span>
    <div class="tm-leg-cats">
      {legendEntries.map(e => (
        <span class="tm-leg-cat">
          <span class="tm-leg-swatch" style={`background:${e.color};`}></span>
          {e.label}
        </span>
      ))}
    </div>
  </div>
</figure>
