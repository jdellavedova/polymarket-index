---
export interface Props {
  formspreeEndpoint?: string;
}
// Defaults to the same Formspree account, but a dedicated form is recommended.
// To use a separate form: create one in Formspree, copy its endpoint,
// pass it as a prop from the parent page.
const { formspreeEndpoint = "https://formspree.io/f/mzdyjdqe" } = Astro.props;
---
<section class="email-signup">
  <div class="es-label">Weekly updates</div>
  <p class="es-blurb">
    One email per week with the updated indices, the &ldquo;this week on Polymarket&rdquo; narrative,
    and any methodology changes. No pitches. No market recommendations. Unsubscribe in one click.
  </p>
  <form
    class="es-form"
    action={formspreeEndpoint}
    method="POST"
  >
    <input type="email" name="email" placeholder="your.email@example.com" required />
    <input type="hidden" name="_subject" value="DV-PMI weekly subscribe" />
    <input type="hidden" name="intent" value="subscribe_weekly" />
    <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
    <button type="submit">Subscribe</button>
  </form>
  <p class="es-fineprint">
    Your email is used only for the weekly update. Not shared. Not sold.
  </p>
</section>
