---
export interface Props {
  dataUrl: string;
  xField?: string;
  yField?: string;
  smoothField?: string;
  yLabel?: string;
  height?: number;
  zeroLine?: boolean;
  containerId?: string;
  ariaLabel?: string;
}
const {
  dataUrl,
  xField = "date",
  yField = "value",
  smoothField,
  yLabel = "",
  height = 280,
  zeroLine = false,
  containerId = "chart-" + Math.random().toString(36).slice(2, 9),
  ariaLabel = yLabel ? `Weekly time series chart of ${yLabel}` : "Weekly time series chart",
} = Astro.props;
---
<div class="chart" id={containerId} style={`min-height:${height}px`} role="img" aria-label={ariaLabel}></div>
<script type="module" data-astro-rerun define:vars={{ dataUrl, xField, yField, smoothField, yLabel, height, zeroLine, containerId }}>
  import * as Plot from "https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6.17/+esm";
  const root = document.documentElement;
  const css = getComputedStyle(root);
  const cPrimary = css.getPropertyValue("--chart-primary").trim() || "#75bee9";
  const cSecondary = css.getPropertyValue("--chart-secondary").trim() || "#0074c8";
  const cText = css.getPropertyValue("--chart-text").trim() || "#c4d2e4";
  const cGrid = css.getPropertyValue("--chart-grid").trim() || "#1f3152";
  const cBg = css.getPropertyValue("--bg").trim() || "#0a1420";

  const res = await fetch(dataUrl);
  const raw = await res.json();
  const data = raw.map(d => ({ ...d, [xField]: new Date(d[xField]) }));
  const marks = [
    Plot.ruleY(zeroLine ? [0] : [], { stroke: cText, strokeOpacity: 0.4 }),
    Plot.lineY(data, { x: xField, y: yField, stroke: cSecondary, strokeWidth: 1.2, strokeOpacity: 0.85 }),
  ];
  if (smoothField) {
    marks.push(Plot.lineY(data, { x: xField, y: smoothField, stroke: cPrimary, strokeWidth: 2.2 }));
  }
  // Hover tooltip: nearest week on the x axis, weekly + smoothed values.
  const tipField = smoothField || yField;
  const card = css.getPropertyValue("--card").trim() || "#11243d";
  marks.push(
    Plot.ruleX(data, Plot.pointerX({ x: xField, stroke: cText, strokeOpacity: 0.25 })),
    Plot.tip(data, Plot.pointerX({
      x: xField,
      y: tipField,
      fill: card,
      stroke: cGrid,
      fontSize: 12,
      title: (d) => {
        const date = d[xField] instanceof Date ? d[xField].toISOString().slice(0, 10) : d[xField];
        const lines = [`week of ${date}`];
        if (d[yField] != null) lines.push(`weekly: ${Number(d[yField]).toFixed(3)}`);
        if (smoothField && d[smoothField] != null) lines.push(`13w MA: ${Number(d[smoothField]).toFixed(3)}`);
        return lines.join("\n");
      },
    })),
  );
  const el = document.getElementById(containerId);
  el.replaceChildren(
    Plot.plot({
      width: Math.min(el.clientWidth || 680, 680),
      height,
      marginLeft: 52,
      marginRight: 12,
      marginBottom: 36,
      style: { background: cBg, color: cText, fontFamily: "Sofia Sans, sans-serif" },
      y: { label: yLabel, grid: true },
      x: { label: "" },
      color: { scheme: "blues" },
      marks,
    })
  );
  // Plot does not expose grid color via style; recolor grid lines post-render.
  el.querySelectorAll("g[aria-label='y-grid'] line, g[aria-label='x-grid'] line").forEach(l => {
    l.setAttribute("stroke", cGrid);
  });
</script>
