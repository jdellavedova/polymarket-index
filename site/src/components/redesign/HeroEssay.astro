---
import CumulativePnlChart from "../CumulativePnlChart.astro";
import narrative from "../../../public/data/weekly_narrative.json";
import activity from "../../../public/data/weekly_activity_latest.json";
import cumulative from "../../../public/data/cumulative_pnl_history.json";

// Build the OWID-style lede paragraph from the existing weekly narrative.
// Combine the headline quote and the first 2 sentences into one flowing
// paragraph (~60-90 words). The narrative file is already hand-edited each
// Sunday, so this is the user's voice, not auto-generated.
const sentences: string[] = narrative.sentences ?? [];
const lede: string =
  sentences.slice(0, 2).join(" ") || narrative.headline_quote || "";

const botEnd = cumulative.endpoints?.bot ?? 0;
const retailEnd = cumulative.endpoints?.active_retail ?? 0;

function fmtUsd(n: number): string {
  const sign = n < 0 ? "-" : (n > 0 ? "+" : "");
  const a = Math.abs(n);
  if (a >= 1e9) return `${sign}$${(a/1e9).toFixed(2)}B`;
  if (a >= 1e6) return `${sign}$${(a/1e6).toFixed(0)}M`;
  if (a >= 1e3) return `${sign}$${(a/1e3).toFixed(0)}K`;
  return `${sign}$${a.toFixed(0)}`;
}
---
<section class="re-hero">
  <div class="re-hero-text">
    <p class="re-stamp">Updated {activity.week} &middot; week of {activity.as_of}</p>
    <h1 class="re-h1">Della Vedova Prediction Market Indices</h1>

    <p class="re-lede">{lede}</p>

    <p class="re-cum-line">
      Cumulative since November 2022:
      <span class="re-cum-bot">{fmtUsd(botEnd)} to algorithmic wallets</span>
      &middot;
      <span class="re-cum-retail">{fmtUsd(retailEnd)} from active retail</span>.
    </p>

    <p class="re-source">
      Source: <a href="/research">Della Vedova (2026), &ldquo;Who Profits from Prediction Markets?&rdquo;</a>
      &middot; <a href="/methodology">Methodology</a>
      &middot; <a href="/data">Download data</a>
      &middot; <a href="/briefings">This week&rsquo;s briefings</a>
    </p>
  </div>

  <div class="re-hero-chart">
    <CumulativePnlChart />
  </div>
</section>
