---
import pwi from "../../public/data/pwi_latest.json";
import botShare from "../../public/data/bot_share_latest.json";
import efficiency from "../../public/data/efficiency_latest.json";
import execution from "../../public/data/execution_latest.json";

type Label = {
  text: string;
  detail: string;
};

const labels: Label[] = [];

// Algorithmic share regime
if (botShare.value >= 0.85) {
  labels.push({
    text: "Bot-dominated",
    detail: `Algorithmic wallets at ${(botShare.value * 100).toFixed(0)}% of weekly trades`,
  });
} else if (botShare.value >= 0.60) {
  labels.push({
    text: "Mixed liquidity",
    detail: `Bots at ${(botShare.value * 100).toFixed(0)}%, humans at ${(100 - botShare.value * 100).toFixed(0)}%`,
  });
} else {
  labels.push({
    text: "Human-dominated",
    detail: `Retail and sophisticated wallets account for ${(100 - botShare.value * 100).toFixed(0)}% of trades`,
  });
}

// Probability-weighting regime
if (pwi.value >= 0.95 && pwi.value <= 1.05) {
  labels.push({
    text: "Rational pricing",
    detail: `Non-bot Prelec alpha = ${pwi.value.toFixed(3)}, near identity`,
  });
} else if (pwi.value < 0.85) {
  labels.push({
    text: "Tail over-weighting",
    detail: `Non-bot Prelec alpha = ${pwi.value.toFixed(3)}, classical inverse-S`,
  });
} else if (pwi.value > 1.05) {
  labels.push({
    text: "Tail under-weighting",
    detail: `Non-bot Prelec alpha = ${pwi.value.toFixed(3)}, rare reverse pattern`,
  });
} else {
  labels.push({
    text: "Mild distortion",
    detail: `Non-bot Prelec alpha = ${pwi.value.toFixed(3)}`,
  });
}

// Market efficiency regime
if (efficiency.value >= 0.95) {
  labels.push({
    text: "Clean regime",
    detail: `Prelec fit R-squared = ${efficiency.value.toFixed(3)}, one-parameter description fits well`,
  });
} else if (efficiency.value >= 0.8) {
  labels.push({
    text: "Moderate noise",
    detail: `Prelec fit R-squared = ${efficiency.value.toFixed(3)}`,
  });
} else {
  labels.push({
    text: "Noisy regime",
    detail: `Prelec fit R-squared = ${efficiency.value.toFixed(3)}, event-driven pricing dominates`,
  });
}
---
<section class="regime">
  <div class="regime-label">This week's regime</div>
  <div class="regime-pills">
    {labels.map(l => (
      <div class="pill">
        <span class="pill-text">{l.text}</span>
        <span class="pill-detail">{l.detail}</span>
      </div>
    ))}
  </div>
  <p class="regime-note">
    Regime labels are deterministic functions of the current index values. They describe the
    week's state, not a trade recommendation.
  </p>
</section>
