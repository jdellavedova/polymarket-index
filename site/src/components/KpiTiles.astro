---
import activity from "../../public/data/weekly_activity_latest.json";
import priceGap from "../../public/data/price_gap_latest.json";
import profitSplit from "../../public/data/profit_split_latest.json";
import pii from "../../public/data/pii_latest.json";

function usdCompact(v: number) {
  const sign = v < 0 ? "-" : "";
  const a = Math.abs(v);
  if (a >= 1e9) return sign + "$" + (a / 1e9).toFixed(2) + "B";
  if (a >= 1e6) return sign + "$" + (a / 1e6).toFixed(0) + "M";
  if (a >= 1e3) return sign + "$" + (a / 1e3).toFixed(0) + "K";
  return sign + "$" + a.toFixed(0);
}
function compactInt(n: number) {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (n >= 1e3) return n.toLocaleString();
  return n.toString();
}

const profitByType = profitSplit.by_type as Record<string, any>;
const botPnl = profitByType.bot?.pnl ?? 0;
const retailPnl = profitByType.active_retail?.pnl ?? 0;
let winnerLabel = "MIXED";
let winnerSub = "";
let winnerCls = "flat";
if (botPnl > 0 && retailPnl < 0) {
  winnerLabel = "ALGORITHMIC";
  winnerSub = `${usdCompact(botPnl)} to algorithms (W${profitSplit.as_of_week.split("-W")[1]})`;
  winnerCls = "up";
} else if (retailPnl > 0 && botPnl < 0) {
  winnerLabel = "RETAIL";
  winnerSub = `${usdCompact(retailPnl)} to humans (W${profitSplit.as_of_week.split("-W")[1]})`;
  winnerCls = "down";
} else if (botPnl > 0 && retailPnl > 0) {
  winnerLabel = "BOTH";
  winnerSub = `Both sides positive (W${profitSplit.as_of_week.split("-W")[1]})`;
  winnerCls = "up";
} else {
  winnerLabel = "NEITHER";
  winnerSub = `Both sides negative (W${profitSplit.as_of_week.split("-W")[1]})`;
  winnerCls = "down";
}

// Longshot bias: gap is realized win rate minus band midpoint (5%).
// Negative gap = longshots overpriced (classical favorite-longshot bias).
const longshotGap = priceGap.value;
const longshotPct = (Math.abs(longshotGap) * 100).toFixed(1) + "%";
const longshotSign = longshotGap >= 0 ? "+" : "−";
const longshotSub = longshotGap < 0 ? "longshots overpriced" : "longshots underpriced";
const longshotCls = longshotGap < 0 ? "down" : "up";

const tiles = [
  {
    label: "TOTAL VOLUME",
    value: usdCompact(activity.total_usd_volume),
    sub: "traded this week",
    cls: "flat",
  },
  {
    label: "ALGORITHMIC SHARE",
    value: (activity.by_type_share.bot * 100).toFixed(0) + "%",
    sub: "of weekly participation events",
    cls: "flat",
  },
  {
    label: "NEW PARTICIPANTS",
    value: compactInt(activity.new_wallets),
    sub: "first-ever trade this week",
    cls: "flat",
  },
  {
    label: "WHO WON THIS WEEK",
    value: winnerLabel,
    sub: winnerSub,
    cls: winnerCls,
  },
  {
    label: "LONGSHOT BIAS",
    value: longshotSign + longshotPct,
    sub: longshotSub,
    cls: longshotCls,
  },
  {
    label: "FLAGGED WALLETS ACTIVE",
    value: compactInt(activity.flagged_active_this_week),
    sub: `of ${compactInt(pii.headline.total_flagged_p_lt_01)} insider-flagged wallets`,
    cls: "flat",
  },
];
---
<section class="kpi-tiles">
  {tiles.map(t => (
    <div class={`kpi-tile ${t.cls}`}>
      <div class="kpi-label">{t.label}</div>
      <div class="kpi-value">{t.value}</div>
      <div class="kpi-sub">{t.sub}</div>
    </div>
  ))}
</section>
