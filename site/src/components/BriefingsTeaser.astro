---
import briefings from "../../public/data/briefings_latest.json";

const top3 = (briefings.briefings as any[]).slice(0, 3);
const total = (briefings.briefings as any[]).length;

function compactImplied(annos: any[]): string | null {
  for (const a of annos) {
    if (a.label === "Implied probability") {
      // strip the "▲ +Xpp 7d" suffix for compact display
      return a.value.split(/\s/)[0] + " " + (a.value.includes("YES") ? "YES" : "");
    }
    if (a.label === "Status") return a.value;
  }
  return null;
}

function compactVol(annos: any[]): string | null {
  for (const a of annos) if (a.label === "Weekly volume") return a.value;
  return null;
}

function compactBot(annos: any[]): string | null {
  for (const a of annos) {
    if (a.label === "Algorithmic share (this market)") {
      const m = a.value.match(/^(\d+)%/);
      return m ? `${m[1]}% algo` : a.value;
    }
  }
  return null;
}
---
<section class="briefings-teaser">
  <div class="bt-head">
    <div>
      <div class="bt-eyebrow">This week&rsquo;s briefings</div>
      <div class="bt-sub">Per-market microstructure on the top 6 Polymarket contracts</div>
    </div>
    <a class="bt-all" href="/briefings">Read all {total} &rarr;</a>
  </div>
  <div class="bt-grid">
    {top3.map(b => (
      <a class="bt-card" href="/briefings#m-{b.market_id}">
        <div class="bt-row1">
          <span class="bt-cat">{b.category}</span>
          <span class="bt-rank">#{b.rank}</span>
        </div>
        <div class="bt-q">{b.question}</div>
        <div class="bt-stats">
          {compactImplied(b.annotations) && <span class="bt-stat bt-stat-imp">{compactImplied(b.annotations)}</span>}
          {compactVol(b.annotations) && <span class="bt-stat">{compactVol(b.annotations)}</span>}
          {compactBot(b.annotations) && <span class="bt-stat">{compactBot(b.annotations)}</span>}
        </div>
      </a>
    ))}
  </div>
</section>
