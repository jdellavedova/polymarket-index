---
export interface Props {
  dataUrl: string;
  height?: number;
  containerId?: string;
}
const {
  dataUrl,
  height = 260,
  containerId = "pii-" + Math.random().toString(36).slice(2, 9),
} = Astro.props;
---
<div class="chart" id={containerId} style={`min-height:${height}px`} role="img" aria-label="Bar chart of wallet flag rates by MNPI category: vote, action, performance, and stochastic"></div>
<script type="module" data-astro-rerun define:vars={{ dataUrl, height, containerId }}>
  import * as Plot from "https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6.17/+esm";
  const css = getComputedStyle(document.documentElement);
  const cPrimary = css.getPropertyValue("--chart-primary").trim() || "#75bee9";
  const cText = css.getPropertyValue("--chart-text").trim() || "#c4d2e4";
  const cGrid = css.getPropertyValue("--chart-grid").trim() || "#1f3152";
  const cBg = css.getPropertyValue("--bg").trim() || "#0a1420";

  const res = await fetch(dataUrl);
  const pii = await res.json();
  const order = ["vote", "action", "performance", "stochastic"];
  const labels = { vote: "Vote", action: "Action", performance: "Performance", stochastic: "Stochastic" };
  const data = pii.mnpi_taxonomy
    .slice()
    .sort((a, b) => order.indexOf(a.mnpi_type) - order.indexOf(b.mnpi_type))
    .map(d => ({
      type: labels[d.mnpi_type] ?? d.mnpi_type,
      flag_rate: d.flag_rate_01,
      n_tested: d.n_wallets_tested,
    }));
  const el = document.getElementById(containerId);
  el.replaceChildren(
    Plot.plot({
      width: Math.min(el.clientWidth || 680, 680),
      height,
      marginLeft: 110,
      marginRight: 48,
      marginBottom: 40,
      style: { background: cBg, color: cText, fontFamily: "Sofia Sans, sans-serif" },
      x: { label: "wallet flag rate (p < 0.01)", grid: true, tickFormat: d => (d * 100).toFixed(1) + "%" },
      y: { label: "", domain: order.map(o => labels[o] ?? o) },
      marks: [
        Plot.ruleX([0], { stroke: cText, strokeOpacity: 0.3 }),
        Plot.barX(data, { y: "type", x: "flag_rate", fill: cPrimary }),
        Plot.text(data, {
          y: "type",
          x: "flag_rate",
          text: d => (d.flag_rate * 100).toFixed(2) + "%",
          dx: 6,
          textAnchor: "start",
          fontSize: 12,
          fill: cText,
        }),
      ],
    })
  );
  el.querySelectorAll("g[aria-label='y-grid'] line, g[aria-label='x-grid'] line").forEach(l => {
    l.setAttribute("stroke", cGrid);
  });
</script>
