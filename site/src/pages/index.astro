---
import Base from "../layouts/Base.astro";
import ThisWeek from "../components/ThisWeek.astro";
import KpiTiles from "../components/KpiTiles.astro";
import EmailSignup from "../components/EmailSignup.astro";

import pwi from "../../public/data/pwi_latest.json";
import execution from "../../public/data/execution_latest.json";
import botShare from "../../public/data/bot_share_latest.json";
import priceGap from "../../public/data/price_gap_latest.json";
import efficiency from "../../public/data/efficiency_latest.json";
import pii from "../../public/data/pii_latest.json";
import calibration from "../../public/data/calibration_latest.json";
import topMarkets from "../../public/data/top_markets_latest.json";
import activity from "../../public/data/weekly_activity_latest.json";
import profitSplit from "../../public/data/profit_split_latest.json";

function usdCompact(v: number) {
  const sign = v < 0 ? "-" : "";
  const a = Math.abs(v);
  if (a >= 1e9) return sign + "$" + (a / 1e9).toFixed(2) + "B";
  if (a >= 1e6) return sign + "$" + (a / 1e6).toFixed(1) + "M";
  if (a >= 1e3) return sign + "$" + (a / 1e3).toFixed(0) + "K";
  return sign + "$" + a.toFixed(0);
}

function fmt(n: number, digits = 3) {
  if (n === null || n === undefined || Number.isNaN(n)) return "n/a";
  return n.toFixed(digits);
}
function pct(n: number, digits = 1) {
  if (n === null || n === undefined || Number.isNaN(n)) return "n/a";
  return (n * 100).toFixed(digits) + "%";
}
function signed(n: number | null | undefined, d = 2) {
  if (n === null || n === undefined || Number.isNaN(n)) return null;
  return (n >= 0 ? "+" : "") + n.toFixed(d);
}
function arrow(z: number | null | undefined) {
  if (z === null || z === undefined || Number.isNaN(z)) return "";
  if (z > 1) return "▲▲";
  if (z > 0.5) return "▲";
  if (z < -1) return "▼▼";
  if (z < -0.5) return "▼";
  return "";
}
function zCls(z: number | null | undefined) {
  if (z === null || z === undefined || Number.isNaN(z)) return "flat";
  if (z > 0.5) return "pos";
  if (z < -0.5) return "neg";
  return "flat";
}

// Pull the MNPI flag-rate breakdown for the Informational block
const mnpiOrder = ["vote", "action", "performance", "stochastic"];
const mnpiLabels: Record<string, string> = {
  vote: "Vote", action: "Action", performance: "Performance", stochastic: "Stochastic",
};
const mnpiRows = pii.mnpi_taxonomy
  .slice()
  .sort((a, b) => mnpiOrder.indexOf(a.mnpi_type) - mnpiOrder.indexOf(b.mnpi_type));

// Shares come from the weekly activity aggregator (true trade counts per type,
// not Prelec-fit-included counts). This fixes the earlier casual=0, one_shot=0
// artifact where those types failed the min-bin test in the Prelec fit.
const classShares = [
  { label: "Algorithmic", share: activity.by_type_share.bot, trades: activity.by_type_participations.bot,
    note: "50+ trades/day or 1,000+ lifetime. Market-making scripts, arbitrage bots, and other high-frequency algorithms." },
  { label: "Active Retail", share: activity.by_type_share.active_retail, trades: activity.by_type_participations.active_retail,
    note: "10 to 1,000 lifetime trades. Think: the engaged hobbyist who bets on elections, sports, and news across many weeks." },
  { label: "Sophisticated", share: activity.by_type_share.sophisticated, trades: activity.by_type_participations.sophisticated,
    note: "Big volume, diversified across markets, 30+ day presence. Think: funds and professional discretionary traders." },
  { label: "Casual", share: activity.by_type_share.casual, trades: activity.by_type_participations.casual,
    note: "Between 2 and 9 lifetime trades. Think: someone who bet on the Super Bowl and one election, then moved on." },
  { label: "One-Shot", share: activity.by_type_share.one_shot, trades: activity.by_type_participations.one_shot,
    note: "A single lifetime trade. Think: placed one bet on a viral market (Taylor Swift engagement, election night) and left." },
];

function smallPct(n: number) {
  const x = n * 100;
  if (x >= 1) return x.toFixed(1) + "%";
  if (x >= 0.01) return x.toFixed(2) + "%";
  if (x >= 0.001) return x.toFixed(3) + "%";
  return "<0.001%";
}
function compactTrades(n: number) {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (n >= 1e3) return (n / 1e3).toFixed(0) + "K";
  return n.toLocaleString();
}

// Profit-split table rows, precomputed to keep typed-dict lookups out of the JSX template
const profitTypeLabels: Record<string, string> = {
  bot: "Algorithmic", active_retail: "Active Retail", sophisticated: "Sophisticated",
  casual: "Casual", one_shot: "One-Shot",
};
const profitByType = profitSplit.by_type as Record<string, any>;
const profitRows = ["bot", "active_retail", "sophisticated", "casual", "one_shot"]
  .map(wt => {
    const r = profitByType[wt];
    if (!r) return null;
    return {
      label: profitTypeLabels[wt],
      n_trades: r.n_trades,
      accuracy: r.accuracy,
      pnl: r.pnl,
      directional_roi_bps: r.directional_roi_bps,
      execution_roi_bps: r.execution_roi_bps,
      pnl_roi_bps: r.pnl_roi_bps,
    };
  })
  .filter((r): r is NonNullable<typeof r> => r !== null);
---
<Base title="Della Vedova Prediction Market Indices (DV-PMI)" description="Weekly descriptive, informational, and sentiment metrics from 671M on-chain Polymarket trades.">
  <section class="hero">
    <p class="hero-eyebrow">Della Vedova Prediction Market Indices</p>
    <h1 class="hero-thesis">
      Prediction markets are algorithmic, asymmetric, and increasingly surveillable.
    </h1>
    <p class="hero-lede">
      We analyze every on-chain Polymarket trade to measure who trades, who profits, where private information shows up, and how human traders misprice uncertainty. <strong>671&thinsp;million trades since November 2022</strong>, refreshed weekly.
    </p>
    <p class="hero-byline">
      Built by <a href="/about">Joshua Della Vedova</a>, Assistant Professor of Finance, University of San Diego.
    </p>
    <div class="hero-cta">
      <a class="cta cta-primary" href="#this-week">This week&rsquo;s read</a>
      <a class="cta" href="/research">Research papers</a>
      <a class="cta" href="/data">Download the data</a>
      <a class="cta" href="/expert-witness">Consulting</a>
    </div>
    <p class="hero-asof">
      Data current through ISO week <strong>{activity.week}</strong> (week of {activity.as_of}). P&amp;L numbers reflect the previous fully-resolved week ({profitSplit.as_of_week}).
    </p>
  </section>

  <ThisWeek />

  <KpiTiles />

  <section class="audience">
    <h2 class="audience-h">Built for three audiences</h2>
    <div class="audience-grid">
      <div class="audience-card">
        <div class="audience-tag">Researchers</div>
        <p>Cite the dataset, replicate the methods, download the weekly indices.</p>
        <a class="audience-link" href="/data">Data &amp; methodology &rarr;</a>
      </div>
      <div class="audience-card">
        <div class="audience-tag">Journalists &amp; analysts</div>
        <p>Ready-to-cite statistics on bots, retail losses, private information, and probability distortions.</p>
        <a class="audience-link" href="/press">Press kit &rarr;</a>
      </div>
      <div class="audience-card">
        <div class="audience-tag">Regulators &amp; counsel</div>
        <p>Microstructure-based surveillance for informed-trading detection and market-integrity review.</p>
        <a class="audience-link" href="/expert-witness">Consulting &rarr;</a>
      </div>
    </div>
  </section>

  <h2 id="this-week">This week&rsquo;s market structure</h2>
  <table class="snapshot">
    <tr><th>Metric</th><th>Value</th><th>Note</th></tr>
    <tr>
      <td>Total USD volume</td>
      <td class="mono">{usdCompact(activity.total_usd_volume)}</td>
      <td class="muted">Dollars traded across every market this week</td>
    </tr>
    <tr>
      <td>Total trades</td>
      <td class="mono">{(activity.total_trades / 1_000_000).toFixed(2)}M</td>
      <td class="muted">One count per on-chain match (each match has a maker and a taker)</td>
    </tr>
    <tr>
      <td>Active wallets</td>
      <td class="mono">{activity.active_wallets.toLocaleString()}</td>
      <td class="muted">Distinct wallets that traded at least once this week (maker or taker)</td>
    </tr>
    <tr>
      <td>New participants this week</td>
      <td class="mono">{activity.new_wallets.toLocaleString()}</td>
      <td class="muted">Wallets that placed their first-ever Polymarket trade this week (13-week average: {Math.round(activity.new_wallets_ma13w).toLocaleString()})</td>
    </tr>
    <tr>
      <td>Flagged wallets active</td>
      <td class="mono">{activity.flagged_active_this_week.toLocaleString()}</td>
      <td class="muted">Wallets flagged by the insider-trading test that actually traded this week (of {pii.headline.total_flagged_p_lt_01.toLocaleString()} flagged in total)</td>
    </tr>
  </table>

  <h3>Who is participating: share by wallet type</h3>
  <table class="snapshot">
    <tr>
      <th>Type</th>
      <th style="text-align:right; width:130px;">Share of participation</th>
      <th style="text-align:right; width:110px;">Participations</th>
      <th>What that means (examples)</th>
    </tr>
    {classShares.map(c => (
      <tr>
        <td>{c.label}</td>
        <td class="mono" style="text-align:right;">{smallPct(c.share)}</td>
        <td class="mono" style="text-align:right;">{compactTrades(c.trades)}</td>
        <td class="muted">{c.note}</td>
      </tr>
    ))}
  </table>
  <details class="section-fineprint">
    <summary>How wallets are typed</summary>
    <p>
      Each match has a maker (limit order) and a taker (market order); both count. Algorithmic wallets are usually the maker, retail and casual traders the taker. Maker-only attribution would assign ~95&#37; to algorithms and hide the human side. The five-type classification follows the lifetime trade-history thresholds in <a href="/research">Paper 1</a>. See the <a href="/methodology">methodology</a> page for details.
    </p>
  </details>

  <h3>Most popular markets by volume</h3>
  <p class="muted">
    Top 5 resolved-trade markets by USD volume in the week of {topMarkets.as_of_week}.
  </p>
  <table class="snapshot">
    <tr>
      <th style="width:32px;">#</th>
      <th>Market</th>
      <th style="width:80px;">Category</th>
      <th style="text-align:right; width:110px;">USD volume</th>
      <th style="text-align:right; width:90px;">Trades</th>
    </tr>
    {topMarkets.markets.map((m) => (
      <tr>
        <td class="mono">{m.rank}</td>
        <td>{m.question ?? <span class="muted">(market #{m.market_id}, not in static metadata)</span>}</td>
        <td class="muted">{m.category ?? "n/a"}</td>
        <td class="mono" style="text-align:right;">{usdCompact(m.usd_volume)}</td>
        <td class="mono" style="text-align:right;">{m.n_trades.toLocaleString()}</td>
      </tr>
    ))}
  </table>
  <p class="muted" style="font-size:14px;">
    Volume is the sum of <code>usdc_amount</code> across resolved trades. Market names come from a static metadata snapshot; markets created after the snapshot appear with IDs only.
  </p>

  <h2>Who wins and who pays <span class="h2-note">(algorithmic wallets vs humans)</span></h2>
  <p class="section-lead">
    Every trade&rsquo;s P&amp;L splits into <em>directional</em> (picked the winner) and <em>execution</em> (better-than-VWAP entry). Cumulative since 2022: bots <strong>+$133M</strong>, retail <strong>&minus;$79M</strong>. Source: <a href="/research">Della Vedova (2026), &ldquo;Who Profits from Prediction Markets?&rdquo;</a>
  </p>
  <details class="section-fineprint">
    <summary>How this table is constructed</summary>
    <p>
      The table shows the most recent fully-resolved week ({profitSplit.as_of_week}; one week behind the activity panel above). Each match is attributed to <strong>both</strong> the maker and the taker side with mirror-signed P&amp;L, so dollar totals sum to zero across wallet types by construction (zero-sum market, no fees). The directional / execution decomposition uses Paper 1&rsquo;s benchmark: per-(market, token) volume-weighted average price across buy-side trades. Bps columns report ROI in basis points (P&amp;L divided by USD volume), not the per-trade edge measure in Paper 1 Table 1; the two are not directly comparable. Single-week numbers can deviate substantially from the cumulative pattern because of trade-mix noise. Participations count both sides of every match.
    </p>
  </details>
  <table class="snapshot">
    <tr>
      <th>Trader type</th>
      <th style="text-align:right;">Participations</th>
      <th style="text-align:right;">Accuracy</th>
      <th style="text-align:right;">Total P&amp;L</th>
      <th style="text-align:right;">Directional ROI (bps)</th>
      <th style="text-align:right;">Execution ROI (bps)</th>
      <th style="text-align:right;">Total ROI (bps)</th>
    </tr>
    {profitRows.map(r => {
      const smallSample = r.n_trades < 5000;
      return (
        <tr>
          <td>{r.label}</td>
          <td class="mono" style="text-align:right;">{compactTrades(r.n_trades)}</td>
          <td class="mono" style="text-align:right;">{r.accuracy != null ? (r.accuracy * 100).toFixed(1) + "%" : "n/a"}</td>
          <td class="mono" style="text-align:right;">{usdCompact(r.pnl)}</td>
          <td class="mono" style="text-align:right;">{smallSample ? "—" : signed(r.directional_roi_bps, 0)}</td>
          <td class="mono" style="text-align:right;">{smallSample ? "—" : signed(r.execution_roi_bps, 0)}</td>
          <td class="mono" style="text-align:right;"><strong>{signed(r.pnl_roi_bps, 0)}</strong></td>
        </tr>
      );
    })}
  </table>
  <p class="muted" style="font-size:14px;">
    Directional + execution = total ROI (an algebraic identity). For trader types with fewer than 5,000 weekly participations (typically casual and one-shot), the component decomposition is dominated by individual-trade VWAP-benchmark noise; we suppress those components and report only the total. The total P&amp;L and ROI are still meaningful at any sample size.
  </p>

  <h3>Algorithmic vs retail execution edge (this week)</h3>
  <table class="snapshot">
    <tr><th>Metric</th><th>Value</th><th>Note</th></tr>
    <tr>
      <td>Algorithmic vs retail execution edge</td>
      <td class="mono">{fmt(execution.value, 3)} {arrow(execution.z52w)}</td>
      <td class="muted">How much better algorithmic wallets are at timing entries vs active retail (z-score vs last year: {signed(execution.z52w)})</td>
    </tr>
  </table>

  <h2>Where private information shows up <span class="h2-note">(insider-trading signal)</span></h2>
  <p class="section-lead">
    A wallet-level test picks out trader accounts whose win rate is too high, too often, to be luck. A higher flag rate means a stronger fingerprint of private information. <strong>Statistical signal, not a legal finding</strong> about any individual. Source: <a href="/research">Della Vedova (2026), &ldquo;Detecting Informed Trading in Prediction Markets.&rdquo;</a>
  </p>

  <table class="snapshot">
    <tr><th>Metric</th><th>Value</th><th>Note</th></tr>
    <tr>
      <td>Wallets flagged as likely informed</td>
      <td class="mono">{pii.headline.total_flagged_p_lt_01.toLocaleString()}</td>
      <td class="muted">Out of {pii.headline.total_wallets_tested.toLocaleString()} we can test ({pct(pii.headline.flag_rate, 2)})</td>
    </tr>
    <tr>
      <td>After strict statistical correction</td>
      <td class="mono">{pii.headline.holm_bonferroni_survivors.toLocaleString()}</td>
      <td class="muted">Even under the harshest multiple-testing correction, this many remain</td>
    </tr>
    <tr>
      <td>After moderate correction</td>
      <td class="mono">{pii.headline.bh_fdr_survivors.toLocaleString()}</td>
      <td class="muted">False-discovery-rate correction (balanced approach)</td>
    </tr>
  </table>

  <h3>Flag rate by market type</h3>
  <p class="section-lead" style="font-size:14px;">
    We group markets by what generates the outcome. Types where somebody could plausibly know in advance (elections, committee decisions) should show higher flag rates than types driven by pure randomness (crypto prices). They do.
  </p>
  <table class="snapshot">
    <tr><th>Category</th><th>Wallets tested</th><th>Flagged (p &lt; 0.01)</th><th>Flag rate</th></tr>
    {mnpiRows.map(m => (
      <tr>
        <td>{mnpiLabels[m.mnpi_type]}</td>
        <td class="mono">{m.n_wallets_tested.toLocaleString()}</td>
        <td class="mono">{m.n_flagged_01.toLocaleString()}</td>
        <td class="mono"><strong>{pct(m.flag_rate_01, 2)}</strong></td>
      </tr>
    ))}
  </table>

  <p class="consulting-handoff">
    Rates and methodology are public. Identification of specific wallets for regulatory, litigation,
    or journalistic purposes is handled case-by-case; see <a href="/expert-witness">consulting</a>.
  </p>

  <h2>How human traders distort probabilities <span class="h2-note">(probability weighting)</span></h2>
  <p class="section-lead">
    Tversky and Kahneman (1992) showed that people overweight rare events and underweight common ones. We measure the same distortion week by week from realized win rates of non-bot Polymarket trades. Source: <a href="/research">Della Vedova and Grant (2026, in progress), &ldquo;Probability Weighting from Prediction Markets.&rdquo;</a>
  </p>
  <table class="snapshot">
    <tr><th>Metric</th><th>Value</th><th>What it says</th></tr>
    <tr>
      <td><a href="/pwi">How traders weight unlikely outcomes</a></td>
      <td class={`mono ${zCls(pwi.z52w)}`}>{fmt(pwi.value, 3)} {arrow(pwi.z52w)}</td>
      <td class="muted">1.0 means rational; below 1 means long shots are over-priced (today vs last year: {signed(pwi.z52w)})</td>
    </tr>
    <tr>
      <td><a href="/price-gap">Long-shot pricing gap</a></td>
      <td class={`mono ${zCls(priceGap.z52w)}`}>{signed(priceGap.value, 3)} {arrow(priceGap.z52w)}</td>
      <td class="muted">How much long shots win minus what the market implies (today vs last year: {signed(priceGap.z52w)})</td>
    </tr>
    <tr>
      <td><a href="/efficiency">Calibration fit</a></td>
      <td class={`mono ${zCls(efficiency.z52w)}`}>{fmt(efficiency.value, 3)} {arrow(efficiency.z52w)}</td>
      <td class="muted">How well one behavioral parameter explains this week&rsquo;s pricing (today vs last year: {signed(efficiency.z52w)})</td>
    </tr>
    <tr>
      <td><a href="/calibration">Long-run probability weighting (all weeks)</a></td>
      <td class="mono">{fmt(calibration.prelec_alpha, 3)}</td>
      <td class="muted">Pooled across every resolved trade since 2022. Kahneman-Tversky experimental value is 0.65.</td>
    </tr>
  </table>

  <p class="muted" style="font-size:14px;">
    Time-series charts and the calibration scatter (Prelec &alpha; = {fmt(calibration.prelec_alpha, 3)}, R&sup2; = {fmt(calibration.prelec_r2, 3)}) live on the deep-dive pages: <a href="/calibration">calibration</a>, <a href="/bot-share">algorithmic share</a>, <a href="/pwi">PWI</a>, <a href="/execution">execution edge</a>, <a href="/price-gap">price gap</a>, <a href="/efficiency">efficiency</a>.
  </p>

  <EmailSignup />

  <h2>Cite this dashboard</h2>
  <div class="citation">Della Vedova, J. (2026). Della Vedova Prediction Market Indices (DV-PMI). v0.1.0. https://jdellavedova.com</div>
  <p class="muted" style="font-size:14px;">
    BibTeX entries for each index are available on its deep-dive page. See the <a href="/methodology">methodology</a>, the <a href="/data">full historical data</a>, and the <a href="/research">source papers</a>.
  </p>
</Base>
