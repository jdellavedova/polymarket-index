---
import DeepDiveLayout from "../components/redesign/DeepDiveLayout.astro";
import CalibrationChart from "../components/CalibrationChart.astro";
import cal from "../../public/data/calibration_latest.json";

function fmt(n, d = 4) { return (n === null || n === undefined || Number.isNaN(n)) ? "n/a" : n.toFixed(d); }

const lede = `Pooled across all resolved non-bot trades (${cal.n_trades_total.toLocaleString()} trades), the Prelec weighting function fits with alpha = ${fmt(cal.prelec_alpha, 3)} and R² = ${fmt(cal.prelec_r2, 3)}. The dashed diagonal is rational pricing; dots above-left and below-right are the longshot bias — long shots win less often than their prices imply, near-certain outcomes more often.`;
---
<DeepDiveLayout
  title="Market Calibration Curve"
  description="Polymarket non-bot realized win rate by price bin with Prelec fit."
  eyebrow="DV-PMI · Calibration"
  lede={lede}
  citeKey="dellavedova2026calibration"
  citeTitle="Market Calibration Curve"
  citePath="calibration">

  <Fragment slot="chart">
    <CalibrationChart dataUrl="/data/calibration_latest.json" height={420} />
  </Fragment>
  <Fragment slot="caption">
    Dots: realized win rate by price bin, sized by trade count. Vertical bars: 95% binomial CIs. Dashed diagonal: identity (a calibrated market). Solid blue: fitted Prelec curve.
  </Fragment>

  <h2>Bin-level data</h2>
  <table>
    <tr><th>Price bin</th><th>Realized win rate</th><th>n trades</th><th>Calibration gap</th></tr>
    {cal.bins.map(b => (
      <tr>
        <td class="mono">{(b.price_bin_center * 100).toFixed(1)}%</td>
        <td class="mono">{(b.realized_win_rate * 100).toFixed(2)}%</td>
        <td class="mono">{b.n_trades.toLocaleString()}</td>
        <td class="mono">{(b.calibration_gap >= 0 ? "+" : "") + (b.calibration_gap * 100).toFixed(2) + "%"}</td>
      </tr>
    ))}
  </table>

  <h2>Methodology</h2>
  <p>
    Non-bot trades (casual, one-shot, active retail, and sophisticated classes) are pooled into 20 price bins of
    width 5%. For each bin, the realized win rate is the share of trades in that bin whose market resolved in
    favor of the position taken. A one-parameter Prelec weighting function w(p) = exp(-(-log p)^alpha) is fit by
    weighted nonlinear least squares, with weights proportional to trade counts. Alpha less than 1 implies the
    classical inverse-S weighting (overweight tails); alpha greater than 1 implies the opposite.
  </p>

  <h2>Data</h2>
  <p>
    <a href="/data/calibration_snapshot.csv">calibration_snapshot.csv</a>
    &middot;
    <a href="/data/calibration_latest.json">calibration_latest.json</a> (includes the fitted curve)
  </p>
</DeepDiveLayout>
