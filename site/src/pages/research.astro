---
import Base from "../layouts/Base.astro";
import CumulativePnlChart from "../components/CumulativePnlChart.astro";
import AuthorityStrip from "../components/redesign/AuthorityStrip.astro";

const SSRN_AUTHOR = "https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id=2583491";
const SCHOLAR = "https://scholar.google.com/citations?user=6KY3PLwAAAAJ&hl=en";
const SSRN_PAPER2 = "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6567238";

// Paper data for the card grid. The "DV-PMI program" papers are featured at
// the top because they're the basis for everything on this site. Other
// publications follow grouped by status.
const programPapers = [
  {
    n: "Paper 1",
    title: "Who Profits from Prediction Markets? Execution, not Information",
    authors: "Della Vedova, J. (2026)",
    venue: "Working paper · 1,059 SSRN downloads",
    status: "Under review",
    statusTone: "active",
    summary: "Trading skill in prediction markets is structurally two-dimensional. Forecasting accuracy and execution quality are distinct, persistent, and nearly independent capacities. Execution, not forecasting, determines which traders profit. Cumulative since 2022: bots +$135.9M, retail −$82.1M.",
    href: SSRN_AUTHOR,
    hrefLabel: "SSRN",
  },
  {
    n: "Paper 2",
    title: "Detecting Informed Trading in Prediction Markets: An Orthogonality Test",
    authors: "Della Vedova, J. (2026)",
    venue: "Working paper · Posted to SSRN April 2026",
    status: "Under review",
    statusTone: "active",
    summary: "The theta-epsilon orthogonality from Paper 1 becomes a forensic detection signal. 6,032 of 450,048 wallets show the structural signature of private information; aggregate gains ≈$150M. A microstructure-grounded, Daubert-ready test statistic. Near-zero flag-set concordance with Mitts and Ofir (2026).",
    href: SSRN_PAPER2,
    hrefLabel: "SSRN abstract 6567238",
  },
  {
    n: "Paper 4",
    title: "Probability Weighting from Prediction Markets",
    authors: "Della Vedova, J. and Grant, A.",
    venue: "Work in progress",
    status: "In progress",
    statusTone: "wip",
    summary: "A model-free measurement of probability weighting from a weekly panel of 671M prediction-market trades. Pooled fit: Prelec α = 0.664, matching the Tversky-Kahneman experimental 0.65. Tests whether the prediction-market-implied weighting index predicts cross-sectional equity anomalies.",
    href: "/calibration",
    hrefLabel: "View live index",
  },
];

const peerReviewed = [
  {
    title: "Investor Behavior at the 52-Week High",
    authors: "Della Vedova, J., Grant, A. R., and Westerholm, P. J.",
    venue: "Journal of Financial and Quantitative Analysis (2023), 58(7), 2852-2889",
    rank: "ABS 4 · ABDC A* · FT50",
    summary: "Individual investors use the 52-week high as a reference price in their trading decisions.",
  },
  {
    title: "Who Drives Momentum Returns? The Role Reversal of Trend-Seeking Households and Contrarian Institutions",
    authors: "Della Vedova, J., Grant, A. R., and Westerholm, P. J.",
    venue: "European Financial Management (2025)",
    rank: "ABS 3 · ABDC A",
    summary: "An investor-class decomposition of cross-sectional momentum returns.",
  },
  {
    title: "Financial Uncertainty and the Cross Section of Cryptocurrency Returns",
    authors: "Colak, G., Della Vedova, J., Foley, S., and Mai, S. T.",
    venue: "Journal of Banking and Finance (forthcoming)",
    rank: "ABS 3 · ABDC A*",
    summary: "Macroeconomic uncertainty and the cross-section of cryptocurrency returns.",
  },
  {
    title: "Equity Borrowing Constraints and the Informed Trading Strategies of Short Sellers",
    authors: "Blau, B. M., Della Vedova, J., Fox, C., and Smith, J. M.",
    venue: "Market Microstructure and Liquidity (forthcoming)",
    rank: "ABDC B",
    summary: "How borrowing constraints shape short-seller information processing.",
  },
  {
    title: "Fostering Reverse Innovation with Value Chain Co-Creation",
    authors: "Kortmann, S., Zimmermann, C., Bliss, B. A., and Della Vedova, J.",
    venue: "IEEE Transactions on Engineering Management (2025), 72, 770-785",
    rank: "ABS 3 · ABDC A",
    summary: "",
  },
];

const otherWorking = [
  {
    title: "The Wrong Reference Price: Trading Strategy and the Disposition Effect",
    authors: "Della Vedova, J. (2026)",
    venue: "Working paper",
    summary: "Most investors form reference prices from the last price rather than the purchase price. Reframing reverses classical disposition findings in a substantial subset of trades.",
    href: SSRN_AUTHOR,
  },
  {
    title: "Investor Disagreement, Liquidity, and Informational Efficiency at the 52-Week High",
    authors: "Della Vedova, J., Gao, M., Grant, A. R., Westerholm, P. J., and Bliss, B. A.",
    venue: "Journal of Banking and Finance, R&R (1st round)",
    summary: "Investor behavior around the 52-week high and its consequences for liquidity and price discovery.",
    href: SSRN_AUTHOR,
  },
  {
    title: "The 1% Problem: LLM Orchestration for Rare Event Detection in Manufacturing Supply Chains",
    authors: "Della Vedova, J., Dang, J., and Yang, Y.",
    venue: "International Journal of Production Economics, R&R (2nd round)",
    summary: "Multi-stage LLM pipelines for rare-event detection in manufacturing supply chains.",
    href: SSRN_AUTHOR,
  },
  {
    title: "The Value of Openness",
    authors: "Della Vedova, J., Siegel, S., and Warachka, M.",
    venue: "Target: Journal of Financial and Quantitative Analysis",
    summary: "The Big Five personality openness trait and its relationship to cross-sectional asset returns.",
    href: SSRN_AUTHOR,
  },
];
---
<Base
  title="Research: Joshua Della Vedova"
  description="Published and working research on prediction markets, microstructure, and behavioral finance."
  wide={true}>

  <section class="dd-hero">
    <div class="dd-hero-text">
      <p class="dd-eyebrow">DV-PMI · Research program</p>
      <h1 class="dd-h1">Research</h1>
      <p class="dd-lede">
        Three working papers form the basis for the DV-PMI dashboard. Paper 1 establishes that trading skill in prediction markets is two-dimensional and that execution, not forecasting, determines who profits. Paper 2 turns the same orthogonality into a forensic test for informed trading. Paper 4 (with Andrew Grant) extracts probability weighting from on-chain trades. Earlier peer-reviewed work spans behavioral finance, microstructure, and momentum.
      </p>
      <p class="dd-stamp">
        Full abstracts on <a href={SSRN_AUTHOR}>SSRN</a> &middot; citations on <a href={SCHOLAR}>Google Scholar</a>
      </p>
    </div>
    <div class="dd-hero-chart">
      <CumulativePnlChart />
      <p class="dd-caption">
        Paper 1's headline finding, in dollars: cumulative P&amp;L on Polymarket since November 2022 by trader type. Bots clear roughly $135M, active retail loses roughly $82M.
      </p>
    </div>
  </section>

  <h2 class="rs-section-h">DV-PMI program</h2>
  <p class="rs-section-sub">The three working papers behind the indices on this site.</p>
  <div class="rs-grid">
    {programPapers.map(p => (
      <a class="rs-card rs-card-program" href={p.href}>
        <div class="rs-card-top">
          <span class="rs-paper-n">{p.n}</span>
          <span class={`rs-status rs-status-${p.statusTone}`}>{p.status}</span>
        </div>
        <div class="rs-card-title">{p.title}</div>
        <div class="rs-card-meta">{p.authors} &middot; {p.venue}</div>
        <p class="rs-card-summary">{p.summary}</p>
        <div class="rs-card-link">{p.hrefLabel} &rarr;</div>
      </a>
    ))}
  </div>

  <h2 class="rs-section-h">Peer-reviewed publications</h2>
  <div class="rs-grid">
    {peerReviewed.map(p => (
      <article class="rs-card">
        <div class="rs-card-top">
          <span class="rs-rank">{p.rank}</span>
        </div>
        <div class="rs-card-title">{p.title}</div>
        <div class="rs-card-meta">{p.authors} &middot; {p.venue}</div>
        {p.summary && <p class="rs-card-summary">{p.summary}</p>}
      </article>
    ))}
  </div>

  <h2 class="rs-section-h">Other working papers</h2>
  <div class="rs-grid">
    {otherWorking.map(p => (
      <a class="rs-card" href={p.href}>
        <div class="rs-card-title">{p.title}</div>
        <div class="rs-card-meta">{p.authors} &middot; {p.venue}</div>
        <p class="rs-card-summary">{p.summary}</p>
        <div class="rs-card-link">SSRN &rarr;</div>
      </a>
    ))}
  </div>

  <AuthorityStrip />
</Base>
