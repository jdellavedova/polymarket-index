---
// Light-mode mockup for side-by-side comparison with the default dark theme.
// Accessible at /mockup-light. Not linked from anywhere; internal preview only.
// Model: Ken French Data Library + Our World in Data + FRED (St. Louis Fed) +
// Daniel Taylor's Wharton FAL. White background, academic serif body, data-first,
// USD Founders Blue (#003b70) as the single accent color.

import Base from "../layouts/Base.astro";
import TimeSeriesChart from "../components/TimeSeriesChart.astro";

import pwi from "../../public/data/pwi_latest.json";
import execution from "../../public/data/execution_latest.json";
import priceGap from "../../public/data/price_gap_latest.json";
import efficiency from "../../public/data/efficiency_latest.json";
import pii from "../../public/data/pii_latest.json";
import calibration from "../../public/data/calibration_latest.json";
import topMarkets from "../../public/data/top_markets_latest.json";
import activity from "../../public/data/weekly_activity_latest.json";
import profitSplit from "../../public/data/profit_split_latest.json";
import narrative from "../../public/data/weekly_narrative.json";

function usdCompact(v: number) {
  const sign = v < 0 ? "-" : "";
  const a = Math.abs(v);
  if (a >= 1e9) return sign + "$" + (a / 1e9).toFixed(2) + "B";
  if (a >= 1e6) return sign + "$" + (a / 1e6).toFixed(0) + "M";
  if (a >= 1e3) return sign + "$" + (a / 1e3).toFixed(0) + "K";
  return sign + "$" + a.toFixed(0);
}
function fmt(n: number, d = 3) { return n == null || Number.isNaN(n) ? "n/a" : n.toFixed(d); }
function pct(n: number, d = 1) { return n == null || Number.isNaN(n) ? "n/a" : (n * 100).toFixed(d) + "%"; }
function signed(n: number | null | undefined, d = 0) {
  if (n == null || Number.isNaN(n)) return "n/a";
  return (n >= 0 ? "+" : "") + n.toFixed(d);
}
function smallPct(n: number) {
  const x = n * 100;
  if (x >= 1) return x.toFixed(1) + "%";
  if (x >= 0.01) return x.toFixed(2) + "%";
  if (x >= 0.001) return x.toFixed(3) + "%";
  return "<0.001%";
}
function compactTrades(n: number) {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (n >= 1e3) return (n / 1e3).toFixed(0) + "K";
  return n.toLocaleString();
}

const classShares = [
  { label: "Bot", share: activity.by_type_share.bot, trades: activity.by_type_participations.bot,
    note: "50+ trades/day or 1,000+ lifetime. Market-making scripts, arbitrage bots, algos." },
  { label: "Active Retail", share: activity.by_type_share.active_retail, trades: activity.by_type_participations.active_retail,
    note: "10 to 1,000 lifetime trades. The engaged hobbyist." },
  { label: "Sophisticated", share: activity.by_type_share.sophisticated, trades: activity.by_type_participations.sophisticated,
    note: "Large volume, diversified, 30+ day presence. Funds and pros." },
  { label: "Casual", share: activity.by_type_share.casual, trades: activity.by_type_participations.casual,
    note: "Between 2 and 9 lifetime trades. Dabblers." },
  { label: "One-Shot", share: activity.by_type_share.one_shot, trades: activity.by_type_participations.one_shot,
    note: "A single lifetime trade. Saw a market, placed one bet." },
];

const profitTypeLabels: Record<string, string> = {
  bot: "Bot", active_retail: "Active Retail", sophisticated: "Sophisticated",
  casual: "Casual", one_shot: "One-Shot",
};
const profitByType = profitSplit.by_type as Record<string, any>;
const profitRows = ["bot", "active_retail", "sophisticated", "casual", "one_shot"]
  .map(wt => {
    const r = profitByType[wt];
    if (!r) return null;
    return {
      label: profitTypeLabels[wt],
      n_trades: r.n_trades,
      accuracy: r.accuracy,
      pnl: r.pnl,
      directional_roi_bps: r.directional_roi_bps,
      execution_roi_bps: r.execution_roi_bps,
      pnl_roi_bps: r.pnl_roi_bps,
    };
  })
  .filter((r): r is NonNullable<typeof r> => r !== null);
---
<Base title="DV-PMI (light mockup)" description="White-background mockup for A/B comparison">
  <style is:global>
    :root {
      color-scheme: light !important;
      --text: #111418 !important;
      --muted: #5a687a !important;
      --border: #e3e0d6 !important;
      --founders: #003b70 !important;
      --immaculata: #0074c8 !important;
      --torero: #2d6ea8 !important;
      --link: #003b70 !important;
      --link-hover: #0074c8 !important;
      --bg: #faf7ef !important;
      --bg-soft: #f0ece0 !important;
      --card: #ffffff !important;
      --pos: #157a3a !important;
      --neg: #9b1c1c !important;
      --chart-primary: #003b70 !important;
      --chart-secondary: #6c8eb0 !important;
      --chart-text: #1a1f26 !important;
      --chart-grid: #d7d2c4 !important;
    }
    html, body { background: #faf7ef !important; color: #111418 !important; }
    .site-head, .site-foot { background: #ffffff !important; border-bottom: 1px solid #e3e0d6; }
    .site-head .brand, .site-head a { color: #003b70 !important; }
    main.container { background: transparent !important; }
    h1, h2, h3 { color: #0a1420 !important; }
    a { color: #003b70; }
    a:hover { color: #0074c8; }
    table.snapshot { border: 1px solid #e3e0d6; background: #ffffff; border-collapse: separate; }
    table.snapshot th { color: #5a687a !important; border-bottom: 1px solid #e3e0d6 !important; padding-left: 10px !important; }
    table.snapshot td { border-bottom: 1px solid #f0ece0; padding-left: 10px !important; }
    table.snapshot tr:last-child td { border-bottom: none; }
    .mono.pos { color: #157a3a !important; }
    .mono.neg { color: #9b1c1c !important; }
    .mockup-banner { background: #fff6d6; border: 1px solid #e4c14a; color: #5a4700; padding: 10px 16px; margin: 0 0 18px; font-family: var(--sans); font-size: 14px; border-radius: 2px; }
    .mockup-banner strong { color: #3d3000; }
    section.this-week { background: #ffffff !important; border: 1px solid #e3e0d6 !important; border-left: 4px solid #003b70 !important; color: #0a1420 !important; }
    section.this-week .tw-label { color: #003b70 !important; }
    section.this-week .tw-quote { color: #0a1420 !important; }
    section.this-week .tw-sentences li { color: #111418 !important; }
    section.this-week .tw-attribution { color: #5a687a !important; }
  </style>

  <div class="mockup-banner"><strong>Light-mode mockup.</strong> For comparison with the default dark theme; not linked from navigation. Content is identical; only the visual styling changes.</div>

  <h1>Della Vedova Prediction Market Indices</h1>
  <p class="subtitle">
    Weekly numbers on who wins, who loses, and how the prediction-market crowd prices what&rsquo;s uncertain. Built from every on-chain Polymarket trade since 2022 (640&thinsp;million and counting).
  </p>

  <section class="this-week" style="padding:16px 20px; margin:24px 0;">
    <div class="tw-label" style="font-size:11px; letter-spacing:0.1em; font-family:var(--sans); text-transform:uppercase; margin-bottom:6px;">This week on Polymarket</div>
    <p class="tw-quote" style="font-size:20px; line-height:1.4; margin:4px 0 10px;">&ldquo;{narrative.headline_quote}&rdquo;</p>
    <ol class="tw-sentences" style="padding-left:18px; font-size:15px; line-height:1.55;">
      {narrative.sentences.map((s) => <li style="margin-bottom:8px;">{s}</li>)}
    </ol>
    <div class="tw-attribution" style="font-size:12px; margin-top:8px;">
      Joshua Della Vedova, University of San Diego &middot; Week of {narrative.as_of}
    </div>
  </section>

  <h2>What happened this week</h2>
  <table class="snapshot">
    <tr><th>Metric</th><th>Value</th><th>Note</th></tr>
    <tr><td>Total USD volume</td><td class="mono">{usdCompact(activity.total_usd_volume)}</td><td class="muted">Dollars traded across every market this week</td></tr>
    <tr><td>Total trades</td><td class="mono">{(activity.total_trades / 1_000_000).toFixed(2)}M</td><td class="muted">One count per on-chain match</td></tr>
    <tr><td>Active wallets</td><td class="mono">{activity.active_wallets.toLocaleString()}</td><td class="muted">Distinct wallets that traded (maker or taker)</td></tr>
    <tr><td>New participants</td><td class="mono">{activity.new_wallets.toLocaleString()}</td><td class="muted">First-ever Polymarket trade this week (13-wk avg: {Math.round(activity.new_wallets_ma13w).toLocaleString()})</td></tr>
    <tr><td>Flagged wallets active</td><td class="mono">{activity.flagged_active_this_week.toLocaleString()}</td><td class="muted">Of {pii.headline.total_flagged_p_lt_01.toLocaleString()} flagged in total, 11% engaged this week</td></tr>
  </table>

  <h3>Who is participating: share by wallet type</h3>
  <table class="snapshot">
    <tr>
      <th>Type</th>
      <th style="text-align:right; width:130px;">Share of participation</th>
      <th style="text-align:right; width:110px;">Participations</th>
      <th>What that means</th>
    </tr>
    {classShares.map(c => (
      <tr>
        <td>{c.label}</td>
        <td class="mono" style="text-align:right;">{smallPct(c.share)}</td>
        <td class="mono" style="text-align:right;">{compactTrades(c.trades)}</td>
        <td class="muted">{c.note}</td>
      </tr>
    ))}
  </table>

  <h3>Most-traded markets this week</h3>
  <table class="snapshot">
    <tr>
      <th style="width:32px;">#</th>
      <th>Market</th>
      <th style="text-align:right; width:110px;">USD volume</th>
      <th style="text-align:right; width:90px;">Trades</th>
    </tr>
    {topMarkets.markets.map(m => (
      <tr>
        <td class="mono">{m.rank}</td>
        <td>{m.question ?? <span class="muted">(market #{m.market_id}, not in static metadata)</span>}</td>
        <td class="mono" style="text-align:right;">{usdCompact(m.usd_volume)}</td>
        <td class="mono" style="text-align:right;">{m.n_trades.toLocaleString()}</td>
      </tr>
    ))}
  </table>

  <h3>Where bots and retail actually make (or lose) money</h3>
  <p class="section-lead" style="font-size:14px;">
    Every trade&rsquo;s P&amp;L splits into <em>directional</em> (picked the winning side) and <em>execution</em> (beat the market&rsquo;s VWAP). ROI in basis points. Benchmark = per-token VWAP.
  </p>
  <table class="snapshot">
    <tr>
      <th>Trader type</th>
      <th style="text-align:right;">Trades</th>
      <th style="text-align:right;">Accuracy</th>
      <th style="text-align:right;">P&amp;L</th>
      <th style="text-align:right;">Dir (bps)</th>
      <th style="text-align:right;">Exec (bps)</th>
      <th style="text-align:right;">Total (bps)</th>
    </tr>
    {profitRows.map(r => (
      <tr>
        <td>{r.label}</td>
        <td class="mono" style="text-align:right;">{compactTrades(r.n_trades)}</td>
        <td class="mono" style="text-align:right;">{r.accuracy != null ? (r.accuracy * 100).toFixed(1) + "%" : "n/a"}</td>
        <td class="mono" style="text-align:right;">{usdCompact(r.pnl)}</td>
        <td class="mono" style="text-align:right;">{signed(r.directional_roi_bps)}</td>
        <td class="mono" style="text-align:right;">{signed(r.execution_roi_bps)}</td>
        <td class="mono" style="text-align:right;"><strong>{signed(r.pnl_roi_bps)}</strong></td>
      </tr>
    ))}
  </table>

  <h2>Who knows something nobody else does</h2>
  <p class="section-lead">
    We run a statistical test that picks out wallets whose win rate is too high, too often, to be luck. Higher flag rates mean a stronger fingerprint of private information. Statistical signal, not a legal finding.
  </p>
  <table class="snapshot">
    <tr><th>Metric</th><th>Value</th><th>Note</th></tr>
    <tr><td>Wallets flagged as likely informed</td><td class="mono">{pii.headline.total_flagged_p_lt_01.toLocaleString()}</td><td class="muted">Out of {pii.headline.total_wallets_tested.toLocaleString()} tested ({pct(pii.headline.flag_rate, 2)})</td></tr>
    <tr><td>After strict correction</td><td class="mono">{pii.headline.holm_bonferroni_survivors.toLocaleString()}</td><td class="muted">Holm-Bonferroni family-wise correction</td></tr>
    <tr><td>After moderate correction</td><td class="mono">{pii.headline.bh_fdr_survivors.toLocaleString()}</td><td class="muted">Benjamini-Hochberg false-discovery-rate</td></tr>
    <tr><td>Bot vs retail execution edge</td><td class="mono">{fmt(execution.value, 3)}</td><td class="muted">Today vs last year: {signed(execution.z52w, 2)}</td></tr>
  </table>

  <h2>How traders are pricing uncertainty</h2>
  <table class="snapshot">
    <tr><th>Metric</th><th>Value</th><th>What it says</th></tr>
    <tr><td><a href="/pwi">How traders weight unlikely outcomes</a></td><td class="mono">{fmt(pwi.value, 3)}</td><td class="muted">1.0 = rational; below 1 = long shots over-priced (vs last year: {signed(pwi.z52w, 2)})</td></tr>
    <tr><td><a href="/price-gap">Long-shot pricing gap</a></td><td class="mono">{signed(priceGap.value, 3)}</td><td class="muted">Long-shot win rate minus market-implied</td></tr>
    <tr><td><a href="/efficiency">Calibration fit</a></td><td class="mono">{fmt(efficiency.value, 3)}</td><td class="muted">How well one parameter explains this week</td></tr>
    <tr><td><a href="/calibration">Long-run probability weighting</a></td><td class="mono">{fmt(calibration.prelec_alpha, 3)}</td><td class="muted">Pooled across all weeks since 2022. TK92 experimental value: 0.65</td></tr>
  </table>

  <h2>Weekly USD volume</h2>
  <p class="section-lead">
    Total dollars traded each week since Polymarket&rsquo;s first resolved market. Heavy line is a 13-week moving average.
  </p>
  <TimeSeriesChart
    dataUrl="/data/weekly_volume_timeseries.json"
    yField="weekly_volume"
    smoothField="weekly_volume_ma13w"
    yLabel="weekly USD volume"
    height={320}
    zeroLine={true}
  />

  <h2>Algorithmic share of participation</h2>
  <TimeSeriesChart
    dataUrl="/data/bot_share_timeseries.json"
    yField="bot_share"
    smoothField="bot_share_ma13w"
    yLabel="share of weekly participation"
    height={280}
    zeroLine={false}
  />

  <h2>Cite this dashboard</h2>
  <div class="citation" style="background:#f0ece0; border-left:3px solid #003b70; padding:10px 14px; font-family:var(--mono); font-size:13px;">Della Vedova, J. (2026). Della Vedova Prediction Market Indices (DV-PMI). v0.1.0. https://jdellavedova.com</div>
  <p class="muted" style="font-size:14px; margin-top:12px;">
    BibTeX entries on each deep-dive page. Full downloads on <a href="/data">/data</a>; methodology on <a href="/methodology">/methodology</a>.
  </p>
</Base>
