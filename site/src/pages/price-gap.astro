---
import DeepDiveLayout from "../components/redesign/DeepDiveLayout.astro";
import TimeSeriesChart from "../components/TimeSeriesChart.astro";
import pg from "../../public/data/price_gap_latest.json";

function fmt(n, d = 3) { return (n === null || n === undefined || Number.isNaN(n)) ? "n/a" : n.toFixed(d); }
function signed(n, d = 3) { return (n === null || n === undefined || Number.isNaN(n)) ? "n/a" : (n >= 0 ? "+" : "") + n.toFixed(d); }
function pct(n, d = 1) { return (n === null || n === undefined || Number.isNaN(n)) ? "n/a" : (n * 100).toFixed(d) + "%"; }

const lede = `As of ${pg.as_of} (week ${pg.week}), the longshot gap is ${signed(pg.value, 3)} with a 52-week rolling z-score of ${signed(pg.z52w, 2)}. Trades at prices below 10% (the longshot band) won at ${pct(pg.components.longshot_winrate, 2)}; the band midpoint is 5%. Positive gaps mean longshots are underpriced; negative gaps are the classical favorite-longshot bias.`;
---
<DeepDiveLayout
  title="Longshot / Favorite Price Gap"
  description="Weekly longshot underpricing signal from Polymarket."
  eyebrow="DV-PMI · Longshot pricing"
  lede={lede}
  asOf={`Updated ${pg.as_of}`}
  citeKey="dellavedova2026pricegap"
  citeTitle="Longshot / Favorite Price Gap"
  citePath="price-gap">

  <Fragment slot="chart">
    <TimeSeriesChart
      dataUrl="/data/price_gap_timeseries.json"
      yField="longshot_gap"
      smoothField="longshot_gap_ma13w"
      yLabel="longshot winrate minus 5%"
      zeroLine={true}
    />
  </Fragment>
  <Fragment slot="caption">
    Positive: longshots are underpriced (realized wins exceed the band midpoint). Negative: the classical favorite-longshot bias.
  </Fragment>

  <h2>Methodology</h2>
  <p>
    Trades at prices below 10% are grouped into the <em>longshot</em> band. Each week we compute the realized
    win rate among those trades and subtract the band midpoint (5%). The resulting gap is the weekly
    underpricing signal. In most weeks, the gap is small and near zero; large positive gaps indicate that
    longshot buyers are systematically winning more than their implied probability, a rare but persistent
    deviation from mean pricing efficiency.
  </p>
  <p>
    The favorite-side analog (top price bin) requires a separate weekly extraction and is planned for a future release.
  </p>

  <h2>Data</h2>
  <p>
    <a href="/data/price_gap_history.csv">price_gap_history.csv</a>
    &middot;
    <a href="/data/price_gap_latest.json">price_gap_latest.json</a>
    &middot;
    <a href="/data/price_gap_timeseries.json">price_gap_timeseries.json</a>
  </p>
</DeepDiveLayout>
