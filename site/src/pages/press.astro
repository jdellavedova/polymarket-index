---
import Base from "../layouts/Base.astro";
import AuthorityStrip from "../components/redesign/AuthorityStrip.astro";
import MentionedIn from "../components/redesign/MentionedIn.astro";
import press from "../../public/data/press_quotes.json";

const featured = press.quotes[0];
const restQuotes = press.quotes.slice(1);
const commentTopics = [
  "Prediction-market microstructure",
  "Polymarket and Kalshi market integrity",
  "Informed trading in event contracts",
  "Retail-trader losses to algorithmic wallets",
  "Algorithmic liquidity provision",
  "Probability weighting and longshot bias",
  "Regulation of binary-event markets",
  "Surveillance methods for crypto-native exchanges",
];
---
<Base
  title="Press and media · DV-PMI"
  description="Quotes ready to cite, recent press, speaking engagements, and contact info for Joshua Della Vedova."
  wide={true}>

  <section class="dd-hero">
    <div class="dd-hero-text">
      <p class="dd-eyebrow">DV-PMI · Press</p>
      <h1 class="dd-h1">Press and media</h1>
      <p class="dd-stamp">Available for comment within 24 hours, weekdays</p>
      <p class="dd-lede">
        Quotes ready to cite, recent press, speaking engagements, and contact info. All quotes below released under <strong>CC BY 4.0</strong>; edit for length or style, keep the attribution. No interview required.
      </p>
      <p class="pr-contact">
        <span class="pr-contact-label">Contact</span>
        <a href="mailto:jdellavedova@sandiego.edu">jdellavedova@sandiego.edu</a>
      </p>

      <div class="pr-comment-box">
        <div class="pr-comment-label">Available for comment on</div>
        <ul class="pr-comment-list">
          {commentTopics.map(t => <li>{t}</li>)}
        </ul>
      </div>
    </div>

    <div class="dd-hero-chart">
      <figure class="pr-featured">
        <div class="pr-featured-label">Featured quote</div>
        <div class="pr-featured-topic">{featured.topic}</div>
        <blockquote class="pr-featured-q">&ldquo;{featured.quote}&rdquo;</blockquote>
        <figcaption class="pr-featured-cite">
          {featured.citation_line}
        </figcaption>
      </figure>
    </div>
  </section>

  <h2 class="bf-section-h">Quotes ready to cite</h2>
  <p class="bf-section-sub">All quotes released under CC BY 4.0; edit freely as long as attribution remains.</p>
  <div class="pr-quote-grid">
    {restQuotes.map(q => (
      <article class="pr-quote-card">
        <div class="pr-quote-topic">{q.topic}</div>
        <blockquote class="pr-quote-text">&ldquo;{q.quote}&rdquo;</blockquote>
        <p class="pr-quote-context">{q.context}</p>
        <p class="pr-quote-cite">{q.citation_line}</p>
      </article>
    ))}
  </div>

  <h2 class="bf-section-h">In the news</h2>

  <a class="featured-video" href="https://www.cnbc.com/video/2026/05/01/finance-professor-josh-della-vedova-talks-new-report-bots-are-outperforming-traders-in-prediction-markets.html" target="_blank" rel="noopener">
    <div class="fv-left">
      <div class="fv-label">▶ Featured video · CNBC · May 1, 2026</div>
      <div class="fv-headline">"Finance Professor Josh Della Vedova talks new report bots are outperforming traders in prediction markets"</div>
      <div class="fv-cta">Watch on CNBC.com →</div>
    </div>
    <div class="fv-right">
      <div class="fv-cnbc">CNBC</div>
    </div>
  </a>

  {press.media_mentions.length === 0 && (
    <p class="bf-section-sub">Recent media mentions will appear here as pieces run.</p>
  )}
  {press.media_mentions.length > 0 && (
    <div class="pr-media-list">
      {press.media_mentions.filter(m => m.outlet !== "CNBC").map(m => (
        <a class="pr-media-row" href={m.url ?? "#"}>
          <span class="pr-media-date">{m.date}</span>
          <span class="pr-media-outlet">{m.outlet}</span>
          <span class="pr-media-headline">{m.headline}</span>
          <span class="pr-media-arrow">&rarr;</span>
        </a>
      ))}
    </div>
  )}

  <MentionedIn />

  <h2 class="bf-section-h">Speaking engagements</h2>
  {press.speaking.length === 0 && (
    <p class="bf-section-sub">Upcoming and recent talks will appear here.</p>
  )}
  {press.speaking.length > 0 && (
    <div class="pr-media-list">
      {press.speaking.map(s => (
        <div class="pr-media-row">
          <span class="pr-media-date">{s.date}</span>
          <span class="pr-media-outlet">{s.venue}</span>
          <span class="pr-media-headline">{s.title}</span>
        </div>
      ))}
    </div>
  )}

  <h2 class="bf-section-h">About the source</h2>
  <p class="pr-about">
    Joshua Della Vedova is an Assistant Professor of Finance at the Knauss School of Business,
    University of San Diego. His research on prediction markets draws on 671&thinsp;million on-chain
    Polymarket trades. See the <a href="/research">research page</a> for working papers, the
    <a href="/methodology">methodology page</a> for index construction, and the
    <a href="/">DV-PMI dashboard</a> for live indices.
  </p>
  <p class="pr-usage muted">{press.usage_note}</p>

  <AuthorityStrip />
</Base>
