---
import DeepDiveLayout from "../components/redesign/DeepDiveLayout.astro";
import TimeSeriesChart from "../components/TimeSeriesChart.astro";
import bot from "../../public/data/bot_share_latest.json";

function pct(n, d = 1) { return (n === null || n === undefined || Number.isNaN(n)) ? "n/a" : (n * 100).toFixed(d) + "%"; }
function signed(n, d = 2) { return (n === null || n === undefined || Number.isNaN(n)) ? "n/a" : (n >= 0 ? "+" : "") + n.toFixed(d); }

const lede = `As of ${bot.as_of}, algorithmic wallets executed ${pct(bot.value, 1)} of weekly counterparty events. The 13-week moving average is ${pct(bot.ma13w, 1)} and the 52-week rolling z-score is ${signed(bot.z52w, 2)}. The share has climbed from near zero in late 2022 to a sustained majority position; humans now appear on roughly one in eight participations.`;
---
<DeepDiveLayout
  title="Algorithmic Share of Participation"
  description="Weekly share of Polymarket counterparty events (maker plus taker sides) attributed to algorithmic wallets."
  eyebrow="DV-PMI · Algorithmic share"
  lede={lede}
  asOf={`Updated ${bot.as_of}`}
  citeKey="dellavedova2026botshare"
  citeTitle="Algorithmic Share of Participation"
  citePath="bot-share">

  <Fragment slot="chart">
    <TimeSeriesChart
      dataUrl="/data/bot_share_timeseries.json"
      yField="bot_share"
      smoothField="bot_share_ma13w"
      yLabel="share of weekly participation"
      zeroLine={false}
    />
  </Fragment>
  <Fragment slot="caption">
    Light line: weekly share. Bold line: 13-week moving average. Each on-chain match has a maker (limit order) and a taker (market order); both are counted as separate participations.
  </Fragment>

  <h2>52-week rolling statistics</h2>
  <table>
    <tr><th>Statistic</th><th>Value</th></tr>
    <tr><td>Mean</td><td class="mono">{pct(bot.rolling.mean_52w, 1)}</td></tr>
    <tr><td>SD</td><td class="mono">{pct(bot.rolling.sd_52w, 2)}</td></tr>
    <tr><td>Min</td><td class="mono">{pct(bot.rolling.min_52w, 1)}</td></tr>
    <tr><td>Max</td><td class="mono">{pct(bot.rolling.max_52w, 1)}</td></tr>
  </table>

  <h2>Methodology</h2>
  <p>
    Wallets are classified as <em>algorithmic</em> if they placed more than 50 trades on their peak day or more
    than 1,000 trades over their lifetime. This rule follows <a href="/research">Paper 1</a>. Algorithmic share is
    the fraction of weekly counterparty events attributable to algorithmic wallets. Each on-chain match has a
    maker (limit order) and a taker (market order); both are counted as separate participations to capture both
    sides honestly. The remainder is split among active retail (10-1,000 trades), sophisticated (large volume
    with diversified HHI), casual (2-9 trades), and one-shot (single trade) classes.
  </p>

  <h2>Data</h2>
  <p>
    <a href="/data/bot_share_history.csv">bot_share_history.csv</a>
    &middot;
    <a href="/data/bot_share_latest.json">bot_share_latest.json</a>
    &middot;
    <a href="/data/bot_share_timeseries.json">bot_share_timeseries.json</a>
  </p>
</DeepDiveLayout>
