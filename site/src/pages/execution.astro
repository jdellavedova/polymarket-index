---
import DeepDiveLayout from "../components/redesign/DeepDiveLayout.astro";
import TimeSeriesChart from "../components/TimeSeriesChart.astro";
import execution from "../../public/data/execution_latest.json";

function fmt(n, d = 3) { return (n === null || n === undefined || Number.isNaN(n)) ? "n/a" : n.toFixed(d); }
function signed(n, d = 2) { return (n === null || n === undefined || Number.isNaN(n)) ? "n/a" : (n >= 0 ? "+" : "") + n.toFixed(d); }
const WALLET_LABEL: Record<string, string> = {
  bot: "Algorithmic",
  active_retail: "Active Retail",
  sophisticated: "Sophisticated",
  casual: "Casual",
  one_shot: "One-Shot",
};
function walletLabel(k: string) { return WALLET_LABEL[k] ?? k; }

const lede = `As of ${execution.as_of}, the algorithmic-minus-retail Prelec alpha gap stands at ${signed(execution.value, 3)}, with a 52-week rolling z-score of ${signed(execution.z52w, 2)}. A positive gap indicates algorithmic wallets weight tails more heavily than active retail — the behavioral signature of execution-quality divergence. Algorithmic Prelec alpha: ${fmt(execution.per_type_alpha.bot?.alpha, 3)}. Active retail: ${fmt(execution.per_type_alpha.active_retail?.alpha, 3)}.`;
---
<DeepDiveLayout
  title="Execution Edge Monitor"
  description="Weekly algorithmic-retail Prelec alpha gap from 671M Polymarket trades."
  eyebrow="DV-PMI · Execution edge"
  lede={lede}
  asOf={`Updated ${execution.as_of}`}
  citeKey="dellavedova2026execution"
  citeTitle="Execution Edge Monitor"
  citePath="execution">

  <Fragment slot="chart">
    <TimeSeriesChart
      dataUrl="/data/execution_timeseries.json"
      yField="alpha_gap"
      smoothField="alpha_gap_ma13w"
      yLabel="algorithmic alpha minus retail alpha"
      zeroLine={true}
    />
  </Fragment>
  <Fragment slot="caption">
    A positive gap indicates algorithmic wallets weight tails more heavily than active retail. The bold line is a 13-week moving average.
  </Fragment>

  <h2>Current per-type alphas</h2>
  <table>
    <tr><th>Wallet class</th><th>Prelec alpha</th></tr>
    {Object.entries(execution.per_type_alpha).map(([k, v]) => (
      <tr><td>{walletLabel(k)}</td><td class="mono">{fmt((v as any).alpha, 3)}</td></tr>
    ))}
  </table>

  <h2>52-week rolling statistics on the gap</h2>
  <table>
    <tr><th>Statistic</th><th>Value</th></tr>
    <tr><td>Mean</td><td class="mono">{fmt(execution.rolling.mean_52w, 3)}</td></tr>
    <tr><td>SD</td><td class="mono">{fmt(execution.rolling.sd_52w, 3)}</td></tr>
    <tr><td>Min</td><td class="mono">{fmt(execution.rolling.min_52w, 3)}</td></tr>
    <tr><td>Max</td><td class="mono">{fmt(execution.rolling.max_52w, 3)}</td></tr>
  </table>

  <h2>Methodology</h2>
  <p>
    For each wallet class (algorithmic, active retail, sophisticated, casual, one-shot), we fit a one-parameter
    Prelec weighting function to that class&rsquo;s weekly calibration curve. The resulting alpha captures how
    strongly the class distorts probabilities away from the identity. The Execution Edge gap is alpha(algorithmic)
    minus alpha(active retail). In <a href="/research">Paper 1</a>, algorithmic wallets capture &minus;4.25 bps
    effective spread on their trades while active retail pays +11.68 bps; the alpha gap is the behavioral
    signature of that divergence and tracks it week-by-week.
  </p>

  <h2>Data</h2>
  <p>
    <a href="/data/execution_history.csv">execution_history.csv</a>
    {' '}(wide, {execution.n_weeks_history} weeks from {execution.first_date})
    &middot;
    <a href="/data/execution_by_type_history.csv">execution_by_type_history.csv</a> (long)
    &middot;
    <a href="/data/execution_latest.json">execution_latest.json</a>
  </p>
</DeepDiveLayout>
