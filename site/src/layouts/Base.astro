---
import "../styles/main.css";
import { ViewTransitions } from "astro:transitions";
import JsonLd from "../components/JsonLd.astro";
import { WEBSITE } from "../lib/schema";

const NAV = [
  { href: "/", label: "Indices" },
  { href: "/briefings", label: "Briefings" },
  { href: "/surveillance", label: "Surveillance" },
  { href: "/research", label: "Research" },
  { href: "/methodology", label: "Methodology" },
  { href: "/data", label: "Data" },
  { href: "/press", label: "Press" },
  { href: "/expert-witness", label: "Consulting" },
  { href: "/about", label: "About" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
function isCurrent(href: string): boolean {
  return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  wide?: boolean;
}
const {
  title,
  description,
  ogImage = "/og.png",
  ogType = "website",
  wide = false,
} = Astro.props;
const year = new Date().getFullYear();
const today = new Date();
const daysUntilSunday = today.getDay() === 0 ? 7 : 7 - today.getDay();
const nextSunday = new Date(today);
nextSunday.setDate(today.getDate() + daysUntilSunday);
const nextRefresh = nextSunday.toLocaleDateString("en-US", { month: "short", day: "numeric" });
const fullOgUrl = new URL(ogImage, Astro.site ?? "https://jdellavedova.com").toString();
const canonical = Astro.url.href;
const desc = description ?? "Weekly behavioral and microstructure indices from 640M on-chain Polymarket trades. By Joshua Della Vedova, University of San Diego.";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <meta name="author" content="Joshua Della Vedova" />
  <meta name="theme-color" content="#0a1420" />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />

  <!-- Fonts (moved from a CSS @import to cut one serial round-trip) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,600;1,400&family=Sofia+Sans:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={fullOgUrl} />
  {ogImage === "/og.png" && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Della Vedova Prediction Market Indices dashboard summary" />
    </>
  )}
  <meta property="og:site_name" content="Della Vedova Prediction Market Indices" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={fullOgUrl} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <JsonLd data={WEBSITE} />
  <ViewTransitions />

  <!-- Cloudflare Web Analytics. Replace CF_BEACON_TOKEN with the token from
       Cloudflare dashboard -> Web Analytics -> Add a site -> jdellavedova.com.
       Free, cookieless, privacy-friendly; gives per-page views and referrers. -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "6e095a5b51a64c9ba2926b31262432d3"}'></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="inner">
      <a class="brand" href="/">Joshua Della Vedova</a>
      <nav aria-label="Primary">
        {NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main" class={wide ? "container container-wide" : "container"}>
    <slot />
  </main>

  <footer class="site-foot">
    <div>
      Joshua Della Vedova &middot; Knauss School of Business &middot; University of San Diego
    </div>
    <div style="margin-top:6px;">
      Data updated weekly &middot; Next refresh: {nextRefresh} &middot; <a href="/methodology">Methodology</a> &middot; <a href="https://orcid.org/0000-0003-3371-9735">ORCID</a> &middot; <a href="https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id=2583491">SSRN</a> &middot; <a href="https://scholar.google.com/citations?user=6KY3PLwAAAAJ&hl=en">Scholar</a> &middot; &copy; {year}
    </div>
    <div class="disclaimer">
      The Della Vedova Prediction Market Indices are a research dataset. Nothing on this site
      is investment advice or a recommendation to buy or sell any prediction-market contract,
      security, or derivative. Past patterns do not predict future outcomes.
    </div>
  </footer>

  <!-- Scroll-reveal: the hidden state is applied by JS only, so content is
       always visible for no-JS users, crawlers, and reduced-motion users. -->
  <script is:inline data-astro-rerun>
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const els = document.querySelectorAll(".re-card,.ds-card,.rs-card,.pk-card,.briefing,.stat-item,.pr-quote-card,.tw-pill,.dd-card");
      const io = new IntersectionObserver((entries) => {
        // Stagger elements that arrive in the same frame so grids cascade.
        let i = 0;
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.style.transitionDelay = Math.min(i++ * 70, 280) + "ms";
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        });
      }, { rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => {
        if (el.getBoundingClientRect().top < innerHeight) return; // skip above-the-fold
        el.classList.add("will-reveal");
        io.observe(el);
      });
    }
  </script>
</body>
</html>
